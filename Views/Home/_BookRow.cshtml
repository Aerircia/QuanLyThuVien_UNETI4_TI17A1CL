@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Dòng sách dạng danh sách (chế độ xem list của kho sách) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BookCardItem
<a class="bk-row" asp-controller="Home" asp-action="Book" asp-route-id="@Model.MaSach">
    <div class="bk-row-cover"><partial name="_BookCover" model="Model" /></div>
    <div class="bk-row-body">
        <h3 class="bk-title">@Model.TenSach</h3>
        <div class="bk-author">@Model.TacGia &middot; @Model.TenTheLoai &middot; @Model.NamXuatBan</div>
        <div class="bk-meta">
            <span class="badge @Model.BadgeClass">@Model.BadgeText</span>
            @if (!string.IsNullOrWhiteSpace(Model.ViTriKe))
            {
                <span class="text-muted small">Kệ @Model.ViTriKe</span>
            }
        </div>
    </div>
    <div class="bk-price bk-row-price">@Model.GiaBia.ToString("N0") ₫</div>
</a>
