@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng thu phạt cho bạn đọc *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ThuPhatBanDocViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{ ViewData["Title"] = "Thu phạt: " + Model.HoTen; }
@section Styles { <link rel="stylesheet" href="~/css/thanhtoan.css" asp-append-version="true" /> }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h4 mb-0">Thu phạt: @Model.HoTen</h1><span class="text-muted small font-monospace">Mã thẻ @(Model.MaSoThe ?? "—")</span></div>
    <a asp-action="ThuPhat" class="btn btn-outline-secondary">← Danh sách</a>
</div>
<partial name="_AlertsPartial" />
<form asp-action="XacNhanThuPhat" asp-route-id="@Model.MaBanDoc" method="post" id="thuPhatForm" data-pay-form>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:44px"><input type="checkbox" class="form-check-input" data-fine-all aria-label="Chọn tất cả" /></th>
                    <th>Phiếu</th><th>Sách</th><th>Ngày trả</th><th>Tình trạng</th><th class="text-end">Trễ</th><th class="text-end">Tiền phạt</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var f in Model.Fines)
            {
                <tr>
                    <td>
                        @if (f.DangCho) { <span class="badge badge-soft-warning" title="Đang có giao dịch trực tuyến chờ thanh toán">Đang chờ</span> }
                        else { <input type="checkbox" class="form-check-input" name="maTras" value="@f.MaTra" data-fine-check data-amount="@((long)f.TienPhat)" aria-label="Chọn khoản phạt phiếu #@f.MaPhieuMuon" /> }
                    </td>
                    <td>#@f.MaPhieuMuon</td><td>@f.TenSach</td><td>@f.NgayTra.ToString("dd/MM/yyyy")</td>
                    <td>@f.TinhTrangSach.GetDisplayName()</td><td class="text-end">@f.SoNgayTre ngày</td>
                    <td class="text-end fw-bold text-danger">@f.TienPhat.ToString("N0") ₫</td>
                </tr>
            }
            @if (!Model.Fines.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Bạn đọc không còn khoản phạt chưa nộp.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="pay-bar">
        <div>Đã chọn <strong data-pay-count>0</strong> khoản</div>
        <div class="pay-total">Tổng thu: <strong data-pay-total>0 ₫</strong></div>
        <button type="button" class="btn btn-primary" data-pay-submit disabled
                data-confirm-form="#thuPhatForm"
                data-confirm-title="Xác nhận thu phạt tại quầy"
                data-confirm-message="Xác nhận bạn đã thu đủ số tiền của các khoản phạt đã chọn?"
                data-confirm-ok="Xác nhận đã thu">Xác nhận đã thu</button>
    </div>
</form>
@section Scripts { <script src="~/js/thanhtoan.js" asp-append-version="true"></script> }
