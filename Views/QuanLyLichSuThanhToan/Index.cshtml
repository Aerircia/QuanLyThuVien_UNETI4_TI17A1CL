@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng danh sách lịch sử thanh toán *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ThanhToanListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Lịch sử thanh toán";
    ViewBag.Pager = Model.Pager;
    ViewData["Ctl"] = "QuanLyLichSuThanhToan"; ViewData["Act"] = "Details"; ViewData["ShowReader"] = true;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h4 mb-0">Quản lý lịch sử thanh toán</h1><p class="text-muted small mb-0">Thanh toán tiền phạt trực tuyến và tại quầy.</p></div>
    <a asp-action="ThuPhat" class="btn btn-primary">Thu phạt tại quầy</a>
</div>
<partial name="_AlertsPartial" />
<div class="card mb-3"><div class="card-body">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Tìm (bạn đọc, mã thẻ, mã đơn)</label><input name="search" value="@Model.Search" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Hình thức</label>
            <select name="phuongThuc" class="form-select" asp-items="Html.GetEnumSelectList<PhuongThucThanhToan>()" asp-for="PhuongThuc"><option value="">Tất cả</option></select></div>
        <div class="col-md-2"><label class="form-label">Trạng thái</label>
            <select name="trangThai" class="form-select" asp-items="Html.GetEnumSelectList<TrangThaiGiaoDich>()" asp-for="TrangThai"><option value="">Tất cả</option></select></div>
        <div class="col-md-2"><label class="form-label">Từ ngày</label><input type="date" name="tu" value="@Model.Tu?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Đến ngày</label><input type="date" name="den" value="@Model.Den?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-1 d-grid"><button class="btn btn-primary">Lọc</button></div>
    </form>
</div></div>
<partial name="_BangGiaoDich" model="Model.Result" />
