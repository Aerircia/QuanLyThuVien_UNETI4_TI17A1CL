@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng thu phạt tại quầy *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.DebtorListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{ ViewData["Title"] = "Thu phạt tại quầy"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h4 mb-0">Thu phạt tại quầy</h1><p class="text-muted small mb-0">Bạn đọc còn khoản phạt chưa nộp.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Lịch sử thanh toán</a>
</div>
<partial name="_AlertsPartial" />
<div class="card mb-3"><div class="card-body">
    <form method="get" asp-action="ThuPhat" class="row g-2">
        <div class="col-md-9"><input name="search" value="@Model.Search" class="form-control" placeholder="Tên hoặc mã thẻ" /></div>
        <div class="col-md-3 d-grid"><button class="btn btn-primary">Tìm</button></div>
    </form>
</div></div>
<div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Bạn đọc</th><th>Mã thẻ</th><th class="text-end">Số khoản</th><th class="text-end">Tổng nợ</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Result.Items)
        {
            <tr>
                <td class="fw-semibold">@d.HoTen</td>
                <td class="font-monospace">@(d.MaSoThe ?? "—")</td>
                <td class="text-end">@d.SoKhoan</td>
                <td class="text-end text-danger fw-bold">@d.TongNo.ToString("N0") ₫</td>
                <td class="text-end"><a asp-action="ThuPhatBanDoc" asp-route-id="@d.MaBanDoc" class="btn btn-sm btn-primary">Thu phạt</a></td>
            </tr>
        }
        @if (!Model.Result.Items.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Không có bạn đọc nào còn nợ phạt.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_PagerPartial" model="Model.Pager" /></div>
