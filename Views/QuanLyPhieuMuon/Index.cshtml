@* Nội dung thực hiện: View quản lý phiếu mượn (Thủ thư & Admin) - 3 nhóm filter, hủy phiếu đã duyệt, tự động hủy quá 7 ngày, AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuMuonManageListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@{
    ViewData["Title"] = "Quản lý phiếu mượn";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 mb-0">Quản lý phiếu mượn</h1>
            <p class="text-muted small mb-0">Xử lý yêu cầu đăng ký mượn sách, xác nhận duyệt, giao sách, hủy phiếu và giám sát hạn trả.</p>
        </div>
        <div>
            <form asp-action="TuDongHuyQuaHan" method="post" class="d-inline loan-action-form" id="autoCancelOverdueForm">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="button" class="btn btn-outline-danger"
                        data-confirm-form="#autoCancelOverdueForm"
                        data-confirm-title="Tự động hủy phiếu quá 7 ngày"
                        data-confirm-message="Hệ thống sẽ quét và hủy tất cả các phiếu mượn đã duyệt nhưng quá 7 ngày bạn đọc chưa đến nhận sách. Bản sách sẽ được hoàn lại kho. Bạn có muốn tiếp tục?"
                        data-confirm-ok="Tự động hủy"
                        data-confirm-class="btn-danger">
                    <i class="bi bi-clock-history"></i> Tự động hủy quá 7 ngày
                </button>
            </form>
        </div>
    </div>

    <partial name="_AlertsPartial" />

    <div id="manageLoansContainer">
        <partial name="_ManageLoansContentPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
    (() => {
        const container = document.getElementById('manageLoansContainer');
        if (!container) return;

        let currentUrl = window.location.href;

        const showAlert = (message, type = 'success') => {
            const alertBox = document.getElementById('manageLoansAlertContainer');
            if (!alertBox) return;
            alertBox.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        const loadContent = async (url, pushState = true) => {
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Network error');
                const html = await res.text();
                container.innerHTML = html;
                currentUrl = url;
                if (pushState) {
                    history.pushState(null, '', url);
                }
            } catch (err) {
                console.error('Failed to load manage loans content', err);
                window.location.href = url;
            }
        };

        // Click các thẻ lọc 3 nhóm và phân trang
        container.addEventListener('click', (e) => {
            const link = e.target.closest('a.filter-card-link, .pagination a');
            if (link && link.href) {
                e.preventDefault();
                loadContent(link.href);
            }
        });

        // Submit form lọc tìm kiếm
        container.addEventListener('submit', (e) => {
            const form = e.target.closest('#manageFilterForm');
            if (form) {
                e.preventDefault();
                const formData = new FormData(form);
                const params = new URLSearchParams(formData);
                const url = `${form.action}?${params.toString()}`;
                loadContent(url);
            }
        });

        // Xử lý gửi các form thao tác (Duyệt, Từ chối, Giao sách, Hủy phiếu, Tự động hủy) qua AJAX
        document.addEventListener('submit', async (e) => {
            const form = e.target.closest('.loan-action-form');
            if (!form) return;

            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            const modalEl = form.closest('.modal');
            if (modalEl && window.bootstrap) {
                bootstrap.Modal.getInstance(modalEl)?.hide();
            }

            try {
                const res = await fetch(form.action, {
                    method: form.method || 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json, text/html;q=0.9'
                    }
                });

                const data = await res.json();
                if (data.success) {
                    showAlert(data.message || 'Thao tác thành công.', 'success');
                } else {
                    showAlert(data.message || 'Thao tác không thành công.', 'danger');
                }
                await loadContent(currentUrl, false);
            } catch (err) {
                console.error('Action submit error', err);
                window.location.reload();
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        });

        // Lịch sử duyệt web (Back/Forward)
        window.addEventListener('popstate', () => {
            loadContent(window.location.href, false);
        });
    })();
    </script>
}
