@* Họ và tên: Phùng Ngọc Bảo *@
@* Mã sinh viên: 23103100278 *@
@* Nội dung thực hiện: Generate view danh sách phiếu mượn: tìm kiếm, lọc, sắp xếp và phân trang. *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.QuanLyPhieuMuonIndexViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums

@{
    ViewData["Title"] = "Quản lý phiếu mượn";
    var trangThaiItems = Html.GetEnumSelectList<TrangThaiPhieuMuon>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } state && item.Value == ((int)state).ToString();
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<h1 class="h4 mb-3">Quản lý phiếu mượn</h1>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-lg-4 col-md-6">
            <label class="form-label" for="search">Bạn đọc hoặc tên sách</label>
            <input id="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Nhập tên bạn đọc hoặc đầu sách" />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label" for="maTheLoai">Thể loại</label>
            <select id="maTheLoai" name="maTheLoai" class="form-select" asp-items="Model.TheLoaiOptions">
                <option value="">Tất cả thể loại</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label" for="trangThai">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select" asp-items="trangThaiItems">
                <option value="">Tất cả trạng thái</option>
            </select>
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label" for="sapXep">Sắp xếp</label>
            <select id="sapXep" name="sapXep" class="form-select">
                <option value="ngay_giam" selected="@(Model.SapXep == "ngay_giam")">Ngày đăng ký mới nhất</option>
                <option value="ngay_tang" selected="@(Model.SapXep == "ngay_tang")">Ngày đăng ký cũ nhất</option>
                <option value="ban_doc" selected="@(Model.SapXep == "ban_doc")">Tên bạn đọc A-Z</option>
                <option value="han_tang" selected="@(Model.SapXep == "han_tang")">Hạn trả tăng dần</option>
                <option value="han_giam" selected="@(Model.SapXep == "han_giam")">Hạn trả giảm dần</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="tuNgay">Từ ngày đăng ký</label>
            <input id="tuNgay" name="tuNgay" type="date" class="form-control"
                   value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="denNgay">Đến ngày đăng ký</label>
            <input id="denNgay" name="denNgay" type="date" class="form-control"
                   value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <input id="quaHan" name="quaHan" value="true" type="checkbox" class="form-check-input"
                       checked="@(Model.QuaHan)" />
                <label for="quaHan" class="form-check-label">Chỉ phiếu quá hạn</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Lọc dữ liệu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">Tổng @Model.Result.TotalCount phiếu mượn</span>
    <a asp-controller="ThongKe" asp-action="Dashboard" class="btn btn-sm btn-outline-primary">Mở Dashboard</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã phiếu</th>
                <th>Bạn đọc / Mã thẻ</th>
                <th>Đầu sách</th>
                <th>Thể loại</th>
                <th>Ngày đăng ký</th>
                <th>Ngày mượn</th>
                <th>Hạn trả</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Result.Items)
        {
            var isLate = item.TrangThai == TrangThaiPhieuMuon.DangMuon && item.HanTra is { } due && due < today;
            var badge = item.TrangThai switch
            {
                TrangThaiPhieuMuon.ChoDuyet => "bg-warning text-dark",
                TrangThaiPhieuMuon.DaDuyet => "bg-primary",
                TrangThaiPhieuMuon.DangMuon => isLate ? "bg-danger" : "bg-info text-dark",
                TrangThaiPhieuMuon.DaTra => "bg-success",
                TrangThaiPhieuMuon.TuChoi => "bg-secondary",
                _ => "bg-dark"
            };
            <tr class="@(isLate ? "table-danger" : "")">
                <td class="fw-semibold">#@item.MaPhieuMuon</td>
                <td>@item.HoTen <div class="small text-muted">@(item.MaSoThe ?? "Chưa có mã thẻ")</div></td>
                <td>@item.TenSach</td>
                <td>@item.TenTheLoai</td>
                <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                <td>@(item.NgayMuon?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    @(item.HanTra?.ToString("dd/MM/yyyy") ?? "—")
                    @if (isLate && item.HanTra is { } overdueDate)
                    {
                        <div class="small text-danger fw-semibold">Quá hạn @((today.DayNumber - overdueDate.DayNumber)) ngày</div>
                    }
                </td>
                <td><span class="badge @badge">@item.TrangThai.GetDisplayName()</span></td>
                <td><a asp-action="Details" asp-route-id="@item.MaPhieuMuon" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
            </tr>
        }
        @if (!Model.Result.Items.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">Không có phiếu mượn phù hợp.</td></tr>
        }
        </tbody>
    </table>
</div>

<partial name="_PagerPartial" model="Model.Pager" />
