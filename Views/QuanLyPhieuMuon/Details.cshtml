@* Họ và tên: Phùng Ngọc Bảo *@
@* Mã sinh viên: 23103100278 *@
@* Nội dung thực hiện: Generate view phiếu mượn, điều kiện duyệt, lịch sử và thao tác trạng thái. *@
@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.PhieuMuonDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums

@{
    ViewData["Title"] = $"Chi tiết phiếu #{Model.MaPhieuMuon}";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var isLate = Model.TrangThai == TrangThaiPhieuMuon.DangMuon && Model.HanTra is { } due && due < today;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Chi tiết phiếu #@Model.MaPhieuMuon</h1>
        <span class="text-muted">Kiểm tra nghiệp vụ trước khi duyệt hoặc giao sách</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

@if (isLate && Model.HanTra is { } dueDate)
{
    <div class="alert alert-danger">Phiếu đã quá hạn @((today.DayNumber - dueDate.DayNumber)) ngày.</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Thông tin mượn sách</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Bạn đọc</dt><dd class="col-sm-8">@Model.HoTen</dd>
                    <dt class="col-sm-4">Mã thẻ</dt><dd class="col-sm-8">@(Model.MaSoThe ?? "—")</dd>
                    <dt class="col-sm-4">Mã bạn đọc</dt><dd class="col-sm-8">@Model.MaBanDoc</dd>
                    <dt class="col-sm-4">Tên sách</dt><dd class="col-sm-8">@Model.TenSach</dd>
                    <dt class="col-sm-4">Thể loại</dt><dd class="col-sm-8">@Model.TenTheLoai</dd>
                    <dt class="col-sm-4">Số lượng tổng</dt><dd class="col-sm-8">@Model.SoLuongTong</dd>
                    <dt class="col-sm-4">Số lượng còn lại</dt><dd class="col-sm-8">@Model.SoLuongConLai</dd>
                    <dt class="col-sm-4">Ngày đăng ký</dt><dd class="col-sm-8">@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Ngày mượn</dt><dd class="col-sm-8">@(Model.NgayMuon?.ToString("dd/MM/yyyy") ?? "Chưa giao")</dd>
                    <dt class="col-sm-4">Hạn trả</dt><dd class="col-sm-8">@(Model.HanTra?.ToString("dd/MM/yyyy") ?? "Chưa xác định")</dd>
                    <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><strong>@Model.TrangThai.GetDisplayName()</strong></dd>
                    <dt class="col-sm-4">Ghi chú bạn đọc</dt><dd class="col-sm-8">@(Model.GhiChu ?? "—")</dd>
                    <dt class="col-sm-4">Ngày xử lý</dt><dd class="col-sm-8">@(Model.NgayXuLy?.ToString("dd/MM/yyyy") ?? "—")</dd>
                    <dt class="col-sm-4">Nhận xét thủ thư</dt><dd class="col-sm-8">@(Model.NhanXetThuThu ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Lịch sử trạng thái</div>
            <div class="card-body">
                @if (Model.LichSu.Count == 0)
                {
                    <p class="text-muted mb-0">Chưa có nhật ký trạng thái. Với phiếu mẫu cũ, có thể cần bổ sung lịch sử dữ liệu seed.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.LichSu)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between flex-wrap gap-1">
                                    <strong>@(item.TrangThaiCu?.GetDisplayName() ?? "Khởi tạo") → @item.TrangThaiMoi.GetDisplayName()</strong>
                                    <span class="small text-muted">@item.NgayThucHien.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                                <div class="small">Người thực hiện: @item.TenNguoiThucHien</div>
                                @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                {
                                    <div class="text-muted small">@item.GhiChu</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        @if (Model.TrangThai == TrangThaiPhieuMuon.ChoDuyet)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Điều kiện trước khi duyệt</div>
                <div class="card-body">
                    @if (Model.CanhBao.Count == 0)
                    {
                        <div class="alert alert-success mb-0">Các điều kiện kiểm tra hiện đạt. Thủ thư vẫn cần xem xét và quyết định.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var warning in Model.CanhBao)
                            {
                                <li class="list-group-item px-0 text-danger"><span aria-hidden="true">✕</span> @warning</li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header fw-semibold">Duyệt hoặc từ chối</div>
                <div class="card-body">
                    <form asp-action="Process" asp-route-id="@Model.MaPhieuMuon" method="post">
                        @Html.AntiForgeryToken()
                        <label for="nhanXetThuThu" class="form-label">Nhận xét (bắt buộc nếu từ chối)</label>
                        <textarea id="nhanXetThuThu" name="nhanXetThuThu" maxlength="100" class="form-control mb-3" rows="3"
                                  placeholder="Nhập lý do từ chối hoặc ghi chú khi duyệt"></textarea>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" name="duyet" value="true" class="btn btn-success"
                                    disabled="@(Model.CanhBao.Count > 0)">Duyệt phiếu</button>
                            <button type="submit" name="duyet" value="false" class="btn btn-outline-danger">Từ chối</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        @if (Model.TrangThai == TrangThaiPhieuMuon.DaDuyet)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Giao sách</div>
                <div class="card-body">
                    <p>Chỉ phiếu đã duyệt mới được giao. Hạn trả sẽ tính theo cấu hình loại bạn đọc.</p>
                    <form asp-action="HandOver" asp-route-id="@Model.MaPhieuMuon" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-primary" type="submit">Xác nhận giao sách</button>
                    </form>
                </div>
            </div>
        }
        @if (Model.TrangThai is TrangThaiPhieuMuon.ChoDuyet or TrangThaiPhieuMuon.DaDuyet)
        {
            <div class="card border-danger">
                <div class="card-header text-danger fw-semibold">Hủy phiếu</div>
                <div class="card-body">
                    <p class="small text-muted">Chỉ hủy phiếu chưa giao sách. Phiếu đang mượn hoặc đã trả không thể hủy ở đây.</p>
                    <form asp-action="Cancel" asp-route-id="@Model.MaPhieuMuon" method="post">
                        @Html.AntiForgeryToken()
                        <label for="ghiChu" class="form-label">Ghi chú hủy (không bắt buộc)</label>
                        <textarea id="ghiChu" name="ghiChu" maxlength="100" class="form-control mb-3" rows="2"></textarea>
                        <button class="btn btn-outline-danger" type="submit">Hủy phiếu</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
