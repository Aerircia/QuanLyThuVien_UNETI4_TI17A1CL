@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view Thủ thư nhận trả sách, dùng AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.TraSachCreateViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Nhận trả sách";
    var p = Model.Preview!;

    decimal TongTheo(TinhTrangSach tt) => tt switch
    {
        TinhTrangSach.HuHong => p.TongHuHong,
        TinhTrangSach.Mat => p.TongMat,
        _ => p.TongBinhThuong
    };
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="mb-1">Nhận trả sách</h1>
        <p class="text-muted mb-0">Phiếu mượn #@p.MaPhieuMuon</p>
    </div>
    <a asp-action="ChoTra" class="btn btn-outline-secondary">Quay lại</a>
</div>

@if (p.SoNgayTre > 0)
{
    <div class="alert alert-overdue" role="alert">
        Phiếu này trả trễ <strong>@p.SoNgayTre ngày</strong>, phạt trễ <strong>@p.TienPhatTre.ToString("N0") đ</strong>.
    </div>
}
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Thông tin phiếu mượn</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Bạn đọc</dt>
                    <dd class="col-sm-8">@p.TenBanDoc @(p.MaSoThe is null ? "" : $"({p.MaSoThe})")</dd>
                    <dt class="col-sm-4">Sách</dt>
                    <dd class="col-sm-8">@p.TenSach</dd>
                    <dt class="col-sm-4">Giá bìa</dt>
                    <dd class="col-sm-8">@p.GiaBia.ToString("N0") đ</dd>
                    <dt class="col-sm-4">Ngày mượn</dt>
                    <dd class="col-sm-8">@(p.NgayMuon?.ToString("dd/MM/yyyy"))</dd>
                    <dt class="col-sm-4">Hạn trả</dt>
                    <dd class="col-sm-8">@(p.HanTra?.ToString("dd/MM/yyyy"))</dd>
                    <dt class="col-sm-4">Ngày trả (hôm nay)</dt>
                    <dd class="col-sm-8">@p.NgayTra.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Số ngày trễ</dt>
                    <dd class="col-sm-8">
                        @if (p.SoNgayTre > 0)
                        {
                            <span class="badge badge-soft-danger">Trễ @p.SoNgayTre ngày</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-success">Đúng hạn</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Tiền phạt theo tình trạng sách</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Khoản phạt</th><th class="text-end">Bình thường</th><th class="text-end">Hư hỏng</th><th class="text-end">Mất</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Phạt trả trễ (@p.SoNgayTre ngày)</td>
                            <td class="text-end">@p.TienPhatTre.ToString("N0") đ</td>
                            <td class="text-end">@p.TienPhatTre.ToString("N0") đ</td>
                            <td class="text-end">@p.TienPhatTre.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td>Phạt tình trạng sách</td>
                            <td class="text-end">0 đ</td>
                            <td class="text-end">@p.PhatHuHong.ToString("N0") đ</td>
                            <td class="text-end">@p.PhatMat.ToString("N0") đ</td>
                        </tr>
                        <tr class="fw-bold">
                            <td>Tổng</td>
                            <td class="text-end">@p.TongBinhThuong.ToString("N0") đ</td>
                            <td class="text-end">@p.TongHuHong.ToString("N0") đ</td>
                            <td class="text-end">@p.TongMat.ToString("N0") đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div id="tra-alert" aria-live="polite"></div>
        @if (!p.DuocTra)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Không thể ghi nhận trả sách:</strong>
                <ul class="mb-0">
                    @foreach (var m in p.CanhBao)
                    {
                        <li>@m</li>
                    }
                </ul>
            </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        }
        else
        {
            <div class="card">
                <div class="card-header">Xác nhận trả sách</div>
                <div class="card-body">
                    <form id="formTraSach" asp-action="Create" asp-route-maPhieuMuon="@p.MaPhieuMuon" method="post">
                        <div asp-validation-summary="ModelOnly" class="mb-2"></div>

                        <div class="mb-3">
                            <label class="form-label">@Html.DisplayNameFor(m => m.TinhTrang)</label>
                            <div class="list-group">
                                @foreach (var tt in Enum.GetValues<TinhTrangSach>())
                                {
                                    var radioId = $"tinhTrang_{tt}";
                                    <label class="list-group-item d-flex align-items-center gap-3" for="@radioId">
                                        <input type="radio" asp-for="TinhTrang" value="@tt" class="form-check-input mt-0" id="@radioId" />
                                        <span class="flex-grow-1">@tt.GetDisplayName()</span>
                                        <span class="fw-semibold">@TongTheo(tt).ToString("N0") đ</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="TinhTrang" class="field-validation-error"></span>
                            <div class="form-text">Số tiền bên phải là tiền phạt nếu chọn tình trạng đó. Hệ thống tính lại khi lưu, Thủ thư không nhập tay.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GhiChu" class="form-label"></label>
                            <textarea asp-for="GhiChu" class="form-control" rows="3" maxlength="100"></textarea>
                            <span asp-validation-for="GhiChu" class="field-validation-error"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" id="btnTraSach" class="btn btn-primary"
                                    data-confirm-form="#formTraSach"
                                    data-confirm-title="Xác nhận trả sách"
                                    data-confirm-message="Bạn xác nhận nhận trả sách này?"
                                    data-confirm-ok="Xác nhận trả sách"
                                    data-confirm-class="btn-primary">
                                Xác nhận trả sách
                            </button>
                            <a asp-action="ChoTra" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
    $(function () {

        function hienThongBao(loai, noiDung) {
            $('#tra-alert').html('<div class="alert alert-' + loai + '"></div>');
            $('#tra-alert .alert').text(noiDung);    
        }

        // ghi tình trạng và tiền phạt đang chọn 
        $('#btnTraSach').click(function (e) {
            var chon = $('#formTraSach input[name="TinhTrang"]:checked');
            if (chon.length === 0) {
                hienThongBao('danger', 'Vui lòng chọn tình trạng sách.');
                e.stopPropagation();         
                return;
            }
            var dong = chon.closest('label');               
            $(this).attr('data-confirm-message',
                'Bạn xác nhận nhận trả sách này? Tình trạng: ' + dong.find('span').eq(0).text() +
                ' - Tiền phạt: ' + dong.find('span').eq(1).text() + '.');
        });

        // form được submit -> gửi AJAX POST
        $('#formTraSach').submit(function (e) {
            e.preventDefault();
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),  
                dataType: 'json',
                success: function (result) {
                    if (result.success) {
                        location.href = result.redirectUrl; 
                        return;
                    }
                    hienThongBao('danger', result.message);
                },
                error: function () {
                    hienThongBao('danger', 'Có lỗi xảy ra, vui lòng thử lại.');
                }
            });
        });
    });
</script>
}