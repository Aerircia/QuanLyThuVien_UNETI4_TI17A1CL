@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: partial bảng phiếu chờ nhận trả + phân trang*@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuChoTraListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    var todayStr = DateOnly.FromDateTime(DateTime.Today).ToString("yyyyMMdd");
    var daNhacDict = Model.DaNhacDict ?? new Dictionary<string, TimeOnly>();
}
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Phiếu</th>
                <th>Bạn đọc</th>
                <th>Sách</th>
                <th>Ngày mượn</th>
                <th>Hạn trả</th>
                <th>Tình trạng</th>
                <th>Nhắc nhở</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Result.Items)
            {
                var quaHan = item.SoNgayTre > 0;
                <tr class="@(quaHan ? "table-danger" : "")">
                    <td class="fw-semibold">#@item.MaPhieuMuon</td>
                    <td>
                        @item.TenBanDoc
                        @if (!string.IsNullOrEmpty(item.MaSoThe))
                        {
                            <small class="text-muted d-block">@item.MaSoThe</small>
                        }
                    </td>
                    <td>@item.TenSach</td>
                    <td>@(item.NgayMuon?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="@(quaHan ? "text-danger fw-semibold" : "")">@(item.HanTra?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>
                        @if (quaHan)
                        {
                            <span class="badge badge-soft-danger">Quá hạn @item.SoNgayTre ngày</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-success">Còn hạn</span>
                        }
                    </td>
                    @{
                        var homNay = DateOnly.FromDateTime(DateTime.Today);
                        int conLai = item.HanTra.HasValue ? item.HanTra.Value.DayNumber - homNay.DayNumber : int.MaxValue;
                        var canNhacTra = quaHan || conLai <= 3;
                        var canNhacGiaHan = !quaHan && conLai <= 3;
                        var khoaTra = $"PhieuMuon_{item.MaPhieuMuon}_NhacTra_{todayStr}";
                        var khoaGiaHan = $"PhieuMuon_{item.MaPhieuMuon}_NhacGiaHan_{todayStr}";
                        daNhacDict.TryGetValue(khoaTra, out var gioNhacTra);
                        daNhacDict.TryGetValue(khoaGiaHan, out var gioNhacGiaHan);
                        
                        var nutTra = new NutNhacNhoViewModel(
                            "NhacTraSach", 
                            item.MaPhieuMuon, 
                            item.TenBanDoc, 
                            item.TenSach, 
                            "Nhắc trả sách", 
                            quaHan ? "btn-outline-danger" : "btn-outline-primary", 
                            gioNhacTra != default ? gioNhacTra : null
                        );

                        var nutGiaHan = new NutNhacNhoViewModel(
                            "NhacGiaHan", 
                            item.MaPhieuMuon, 
                            item.TenBanDoc, 
                            item.TenSach, 
                            "Nhắc gia hạn", 
                            "btn-outline-secondary", 
                            gioNhacGiaHan != default ? gioNhacGiaHan : null
                        );
                    }
                    <td>
                        @if (canNhacTra || canNhacGiaHan)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @if (canNhacTra)
                                {
                                    <partial name="_NutNhacNho" model="nutTra" />
                                }
                                @if (canNhacGiaHan)
                                {
                                    <partial name="_NutNhacNho" model="nutGiaHan" />
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Create" asp-route-maPhieuMuon="@item.MaPhieuMuon" class="btn btn-sm btn-primary text-nowrap">Nhận trả</a>
                    </td>
                </tr>
            }

            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Không có phiếu đang mượn nào chờ nhận trả.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_PagerPartial" model="Model.Pager" />