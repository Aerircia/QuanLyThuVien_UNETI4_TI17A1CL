@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view lịch sử trả sách và tiền phạt *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.TraSachListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Lịch sử trả sách";

    var tinhTrangItems = Html.GetEnumSelectList<TinhTrangSach>().ToList();
    foreach (var item in tinhTrangItems)
        item.Selected = Model.TinhTrang is { } t && item.Value == ((int)t).ToString();

    var phatItems = Html.GetEnumSelectList<TrangThaiPhat>().ToList();
    foreach (var item in phatItems)
        item.Selected = Model.TrangThaiPhat is { } p && item.Value == ((int)p).ToString();
}
<div class="d-flex justify-content-between align-items-center mb-3">
<h1 class="h4 mb-3">Lịch sử trả sách và tiền phạt</h1>
 <a asp-action="ChoTra" class="btn btn-primary">Nhận trả sách</a>
</div>
@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="col-md-4">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên bạn đọc hoặc tên sách" />
    </div>
    <div class="col-md-3">
        <select name="tinhTrang" class="form-select" asp-items="tinhTrangItems">
            <option value="">Mọi tình trạng sách</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="trangThaiPhat" class="form-select" asp-items="phatItems">
            <option value="">Mọi trạng thái phạt</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Phiếu</th>
                <th>Bạn đọc</th>
                <th>Sách</th>
                <th>Ngày trả</th>
                <th>Tình trạng</th>
                <th class="text-end">Ngày trễ</th>
                <th class="text-end">Tiền phạt</th>
                <th>Trạng thái phạt</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Result.Items)
            {
                var phatBadge = item.TrangThaiPhat switch
                {
                    TrangThaiPhat.ChuaNop => "bg-danger",
                    TrangThaiPhat.DaNop => "bg-success",
                    _ => "bg-secondary"
                };
                <tr>
                    <td>#@item.MaPhieuMuon</td>
                    <td>@item.TenBanDoc</td>
                    <td>@item.TenSach</td>
                    <td>@item.NgayTra.ToString("dd/MM/yyyy")</td>
                    <td>@item.TinhTrang.GetDisplayName()</td>
                    <td class="text-end @(item.SoNgayTre > 0 ? "text-danger fw-bold" : "")">@item.SoNgayTre</td>
                    <td class="text-end">@item.TienPhat.ToString("N0") đ</td>
                    <td><span class="badge @phatBadge">@item.TrangThaiPhat.GetDisplayName()</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.MaTra" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        @if (item.TrangThaiPhat == TrangThaiPhat.ChuaNop)
                        {
                            <form asp-action="MarkPaid" asp-route-id="@item.MaTra" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Đã nộp phạt</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">Chưa có bản ghi trả sách nào phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_PagerPartial" model="Model.Pager" />