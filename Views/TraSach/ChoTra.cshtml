@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view danh sách phiếu đang mượn chờ nhận trả, tìm/lọc/phân trang bằng AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuChoTraListViewModel
@{
    ViewData["Title"] = "Phiếu chờ nhận trả";
    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.ChiQuaHan;
}

<div class="mb-3">
    <h1 class="mb-1">Trả sách và tiền phạt</h1>
    <p class="text-muted mb-0">Chọn phiếu đang mượn để nhận sách trả</p>
</div>

<partial name="_TraSach" model='"ChoTra"' />

<partial name="_AlertsPartial" />
<div class="card mb-3">
    <div class="card-body">
        <form id="bo-loc-cho-tra" method="get" asp-action="ChoTra" class="row g-2 align-items-center" data-ajax-filter-form>
            <input type="hidden" id="pageSize" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-6">
                <input id="timKiem" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên, mã số thẻ bạn đọc hoặc tên sách" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350" />
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="chiQuaHan" name="chiQuaHan" value="true"
                           checked="@Model.ChiQuaHan" />
                    <label class="form-check-label" for="chiQuaHan">Chỉ phiếu quá hạn</label>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex gap-2">
                <a asp-action="ChoTra" asp-route-pageSize="@Model.PageSize" data-xoa-loc data-ajax-clear class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>
<div id="vung-ket-qua-cho-tra" data-ajax-list data-ajax-form="#bo-loc-cho-tra" data-ajax-change>
    <partial name="_BangChoTra" model="Model" />
</div>
@section Scripts {
    <script src="~/js/nhac-nho.js" asp-append-version="true"></script>
}
