@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view danh sách phiếu đang mượn chờ nhận trả *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuChoTraListViewModel
@{
    ViewData["Title"] = "Phiếu chờ nhận trả";
    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.ChiQuaHan;
}

<div class="mb-3">
    <h1 class="mb-1">Trả sách và tiền phạt</h1>
    <p class="text-muted mb-0">Chọn phiếu đang mượn để nhận sách trả. Phiếu quá hạn được tô nổi bật.</p>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" asp-action="ChoTra">Chờ nhận trả</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Index">Lịch sử trả sách</a></li>
</ul>

<partial name="_AlertsPartial" />
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="ChoTra" class="row g-2 align-items-center">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-6">
                <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên, mã số thẻ bạn đọc hoặc tên sách" />
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="chiQuaHan" name="chiQuaHan" value="true"
                           checked="@Model.ChiQuaHan" onchange="this.form.requestSubmit()" />
                    <label class="form-check-label" for="chiQuaHan">Chỉ phiếu quá hạn</label>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm</button>
                @if (dangLoc)
                {
                    <a asp-action="ChoTra" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-secondary">Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Phiếu</th>
                <th>Bạn đọc</th>
                <th>Sách</th>
                <th>Ngày mượn</th>
                <th>Hạn trả</th>
                <th>Tình trạng</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Result.Items)
            {
                var quaHan = item.SoNgayTre > 0;
                <tr class="@(quaHan ? "table-danger" : "")">
                    <td class="fw-semibold">#@item.MaPhieuMuon</td>
                    <td>
                        @item.TenBanDoc
                        @if (!string.IsNullOrEmpty(item.MaSoThe))
                        {
                            <small class="text-muted d-block">@item.MaSoThe</small>
                        }
                    </td>
                    <td>@item.TenSach</td>
                    <td>@(item.NgayMuon?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="@(quaHan ? "text-danger fw-semibold" : "")">@(item.HanTra?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>
                        @if (quaHan)
                        {
                            <span class="badge badge-soft-danger">Quá hạn @item.SoNgayTre ngày</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-success">Còn hạn</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Create" asp-route-maPhieuMuon="@item.MaPhieuMuon" class="btn btn-sm btn-primary">Nhận trả</a>
                    </td>
                </tr>
            }

            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có phiếu đang mượn nào chờ nhận trả.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="_PagerPartial" model="Model.Pager" />