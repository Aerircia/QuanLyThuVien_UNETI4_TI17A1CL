@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view danh sách phiếu đang mượn chờ nhận trả, tìm/lọc/phân trang bằng AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuChoTraListViewModel
@{
    ViewData["Title"] = "Phiếu chờ nhận trả";
    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.ChiQuaHan;
}

<div class="mb-3">
    <h1 class="mb-1">Trả sách và tiền phạt</h1>
    <p class="text-muted mb-0">Chọn phiếu đang mượn để nhận sách trả. Phiếu quá hạn được tô nổi bật.</p>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" asp-action="ChoTra">Chờ nhận trả</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Index">Lịch sử trả sách</a></li>
</ul>

<partial name="_AlertsPartial" />
<div class="card mb-3">
    <div class="card-body">
        <form id="bo-loc-cho-tra" method="get" asp-action="ChoTra" class="row g-2 align-items-center">
            <input type="hidden" id="pageSize" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-6">
                <input id="timKiem" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên, mã số thẻ bạn đọc hoặc tên sách" />
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="chiQuaHan" name="chiQuaHan" value="true"
                           checked="@Model.ChiQuaHan" onchange="this.form.requestSubmit()" />
                    <label class="form-check-label" for="chiQuaHan">Chỉ phiếu quá hạn</label>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm</button>
                <a asp-action="ChoTra" asp-route-pageSize="@Model.PageSize" data-xoa-loc class="btn btn-outline-secondary @(dangLoc ? "" : "d-none")">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>
<div id="vung-ket-qua-cho-tra">
    <partial name="_BangChoTra" model="Model" />
</div>

@section Scripts {
<script>
    $(function () {
        function layDieuKien() {
            var dieuKien = {
                search: $('#timKiem').val(),
                pageSize: $('#pageSize').val()
            };
            if ($('#chiQuaHan').is(':checked')) dieuKien.chiQuaHan = true;   
            return dieuKien;
        }
        function taiDanhSach(url, data) {
            $.ajax({
                url: url,
                type: 'GET',
                data: data,
                success: function (result) {
                    $('#vung-ket-qua-cho-tra').html(result);
                },
                error: function () {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                }
            });
        }
        function hienNutXoaLoc() {
            var coLoc = $('#bo-loc-cho-tra').find('input[name="search"], select').filter(function () {
                return $.trim($(this).val()) !== '';
            }).length > 0 || $('#bo-loc-cho-tra').find('input[type="checkbox"]:checked').length > 0;
            $('#bo-loc-cho-tra [data-xoa-loc]').toggleClass('d-none', !coLoc);
        }

        function timKiem() {
            hienNutXoaLoc();
            taiDanhSach($('#bo-loc-cho-tra').attr('action'), layDieuKien());
        }
        $('#bo-loc-cho-tra').submit(function (e) {
            e.preventDefault();
            timKiem();
        });
        $('#bo-loc-cho-tra input[name="search"]').keyup(function () {
            timKiem();
        });
        $('#bo-loc-cho-tra [data-xoa-loc]').click(function (e) {
            e.preventDefault();
            $('#timKiem').val('');
            $('#chiQuaHan').prop('checked', false);
            timKiem();
        });
        $('#vung-ket-qua-cho-tra').on('click', 'nav[aria-label="Phân trang"] a[href]', function (e) {
            e.preventDefault();
            taiDanhSach($(this).attr('href'));
        });
    });
</script>
}