@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: generate view liệt kê tài khoản *@
@* Giao diện lại danh sách tài khoản theo demo_v35, xác nhận khóa/xóa bằng modal (không đổi nghiệp vụ) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.TaiKhoanListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.VaiTro.HasValue || Model.TrangThai.HasValue || Model.Sort != "username";

    var vaiTroItems = Html.GetEnumSelectList<VaiTro>().ToList();
    foreach (var item in vaiTroItems)
        item.Selected = Model.VaiTro is { } v && item.Value == ((int)v).ToString();

    var trangThaiItems = Html.GetEnumSelectList<TrangThaiTaiKhoan>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } t && item.Value == ((int)t).ToString();
}
@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Quản lý tài khoản</h1>
        <p class="text-muted small mb-0">Quản lý thông tin đăng nhập, phân quyền người dùng và trạng thái hoạt động của tài khoản trong hệ thống.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        Thêm tài khoản
    </a>
</div>

<partial name="_AlertsPartial" />

<form id="accountFilter" method="get" asp-action="Index" class="app-card filter-bar" data-ajax-filter-form>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label for="fSearch" class="form-label">Tìm kiếm</label>
            <input id="fSearch" name="search" value="@Model.Search" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350" class="form-control"
                   placeholder="Tên đăng nhập, họ tên, email" />
        </div>
        <div class="col-md-2">
            <label for="fRole" class="form-label">Vai trò</label>
            <select id="fRole" name="vaiTro" class="form-select" asp-items="vaiTroItems">
                <option value="">Tất cả vai trò</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="fSort" class="form-label">Sắp xếp</label>
            <select id="fSort" name="sort" class="form-select">
                <option value="username" selected="@(Model.Sort == "username")">Tên đăng nhập A–Z</option>
                <option value="username_desc" selected="@(Model.Sort == "username_desc")">Tên đăng nhập Z–A</option>
                <option value="name" selected="@(Model.Sort == "name")">Họ tên</option>
                <option value="email" selected="@(Model.Sort == "email")">Email</option>
                <option value="role" selected="@(Model.Sort == "role")">Vai trò</option>
                <option value="status" selected="@(Model.Sort == "status")">Trạng thái</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="fStatus" class="form-label">Trạng thái</label>
            <select id="fStatus" name="trangThai" class="form-select" asp-items="trangThaiItems">
                <option value="">Tất cả trạng thái</option>
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-ajax-clear class="btn btn-outline-secondary">Xóa bộ lọc</a>
        </div>
    </div>
</form>

<div id="accountResults" data-ajax-list data-ajax-form="#accountFilter" data-ajax-change>
<partial name="_IndexResults" model="Model" />
</div>

@* AJAX-enabled filter state; form submit remains a normal GET without JavaScript. *@
@* The results partial includes the table and pager. *@
