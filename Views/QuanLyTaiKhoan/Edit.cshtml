@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: generate view sửa tài khoản *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.TaiKhoanEditViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4 mb-3">Sửa tài khoản</h1>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" autofocus />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
                @if (Model.CoHoSoBanDoc)
                {
                    <div class="form-text">Họ tên và email sẽ được cập nhật đồng thời sang hồ sơ bạn đọc.</div>
                }
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="VaiTro" class="form-label"></label>
                    @if (Model.CoHoSoBanDoc)
                    {
                        @* Tài khoản đã có hồ sơ bạn đọc: không đổi được vai trò (service cũng chặn). *@
                        <input type="hidden" asp-for="VaiTro" />
                        <input class="form-control" value="@Model.VaiTro.GetDisplayName()" readonly />
                        <div class="form-text">Không thể đổi vai trò của tài khoản đã có hồ sơ bạn đọc.</div>
                    }
                    else
                    {
                        <select asp-for="VaiTro" class="form-select" asp-items="Html.GetEnumSelectList<VaiTro>()"></select>
                    }
                    <span asp-validation-for="VaiTro" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TrangThai" class="form-label"></label>
                    <select asp-for="TrangThai" class="form-select" asp-items="Html.GetEnumSelectList<TrangThaiTaiKhoan>()"></select>
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
