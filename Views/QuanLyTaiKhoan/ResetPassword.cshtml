@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế view đặt lại mật khẩu *@
@* Giao diện lại form đặt lại mật khẩu của Admin (không đổi nghiệp vụ) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="page-head">
            <div>
                <h1>Đặt lại mật khẩu</h1>
                <p class="text-muted mb-0">Đặt mật khẩu mới cho tài khoản @Model.TenDangNhap.</p>
            </div>
        </div>

        <div class="app-card account-form">
            <form asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="MaTaiKhoan" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" autofocus />
                        <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#MatKhauMoi" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                    </div>
                    <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="XacNhanMatKhauMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="XacNhanMatKhauMoi" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#XacNhanMatKhauMoi" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                    </div>
                    <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Lưu mật khẩu mới</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forms.js" asp-append-version="true"></script>
}