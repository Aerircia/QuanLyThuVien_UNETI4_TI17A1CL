@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view Thủ thư xem danh sách yêu cầu gia hạn, tìm/lọc/phân trang bằng AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.GiaHanMuonListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Yêu cầu gia hạn";

    var trangThaiItems = Html.GetEnumSelectList<TrangThaiGiaHan>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } t && item.Value == ((int)t).ToString();

    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.TrangThai.HasValue;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">Yêu cầu gia hạn</h1>
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form id="bo-loc-gia-han" method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" id="pageSize" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-6">
                <input id="timKiem" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên bạn đọc hoặc tên sách" />
            </div>
            <div class="col-md-6 col-lg-3">
                <select id="trangThai" name="trangThai" class="form-select" asp-items="trangThaiItems" onchange="this.form.requestSubmit()">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-md-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm</button>
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-xoa-loc class="btn btn-outline-secondary @(dangLoc ? "" : "d-none")">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>
<div id="vung-ket-qua-gia-han">
    <partial name="_BangGiaHan" model="Model" />
</div>

@section Scripts {
<script>
    $(function () {
        function layDieuKien() {
            return {
                search: $('#timKiem').val(),
                trangThai: $('#trangThai').val(),
                pageSize: $('#pageSize').val()
            };
        }
        function taiDanhSach(url, data) {
            $.ajax({
                url: url,
                type: 'GET',
                data: data,
                success: function (result) {
                    $('#vung-ket-qua-gia-han').html(result);
                },
                error: function () {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                }
            });
        }
        function hienNutXoaLoc() {
            var coLoc = $('#bo-loc-gia-han').find('input[name="search"], select').filter(function () {
                return $.trim($(this).val()) !== '';
            }).length > 0 || $('#bo-loc-gia-han').find('input[type="checkbox"]:checked').length > 0;
            $('#bo-loc-gia-han [data-xoa-loc]').toggleClass('d-none', !coLoc);
        }

        function timKiem() {
            hienNutXoaLoc();
            taiDanhSach($('#bo-loc-gia-han').attr('action'), layDieuKien());
        }
        $('#bo-loc-gia-han').submit(function (e) {
            e.preventDefault();
            timKiem();
        });
        $('#bo-loc-gia-han input[name="search"]').keyup(function () {
            timKiem();
        });
        $('#bo-loc-gia-han [data-xoa-loc]').click(function (e) {
            e.preventDefault();
            $('#timKiem').val('');
            $('#trangThai').val('');
            timKiem();
        });
        $('#vung-ket-qua-gia-han').on('click', 'nav[aria-label="Phân trang"] a[href]', function (e) {
            e.preventDefault();
            taiDanhSach($(this).attr('href'));
        });
    });
</script>
}