@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view Thủ thư xem danh sách yêu cầu gia hạn, tìm/lọc/phân trang bằng AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.GiaHanMuonListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Yêu cầu gia hạn";

    var trangThaiItems = Html.GetEnumSelectList<TrangThaiGiaHan>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } t && item.Value == ((int)t).ToString();

    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || Model.TrangThai.HasValue;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">Yêu cầu gia hạn</h1>
</div>

<partial name="_AlertsPartial" />

<div class="card mb-3">
    <div class="card-body">
        <form id="bo-loc-gia-han" method="get" asp-action="Index" class="row g-2 align-items-center" data-ajax-filter-form>
            <input type="hidden" id="pageSize" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-6">
                <input id="timKiem" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên bạn đọc hoặc tên sách" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350" />
            </div>
            <div class="col-md-6 col-lg-3">
                <select id="trangThai" name="trangThai" class="form-select" asp-items="trangThaiItems">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-md-6 col-lg-3 d-flex gap-2">
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-xoa-loc data-ajax-clear class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>
<div id="vung-ket-qua-gia-han" data-ajax-list data-ajax-form="#bo-loc-gia-han" data-ajax-change>
    <partial name="_BangGiaHan" model="Model" />
</div>
