@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: View liệt kê sách (Admin, Thủ thư), cấu trúc đồng bộ với BanDoc/Index *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachListItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    ViewData["Title"] = "Quản lý sách";
    var statuses = Html.GetEnumSelectList<TrangThaiSach>().ToList();
    foreach (var option in statuses)
        option.Selected = ViewBag.TrangThai is TrangThaiSach selected && option.Value == ((int)selected).ToString();
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Quản lý sách</h1>
            <p class="text-muted small mb-0">Thêm, cập nhật và theo dõi tình trạng đầu sách.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Thêm sách</a>
    </div>

    <partial name="_AlertsPartial" />

    <!-- Bộ lọc tìm kiếm -->
    <div class="card mb-3">
        <div class="card-body">
            <form id="bo-loc-sach" method="get" asp-action="Index" class="row g-2 align-items-end">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold">Tìm kiếm (sách, tác giả, NXB)</label>
                    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Nhập từ khóa" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold">Thể loại</label>
                    <select name="maTheLoai" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.TheLoaiOptions">
                        <option value="">Tất cả</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold">Tác giả</label>
                    <select name="tacGia" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var tacGia in (IEnumerable<string>)ViewBag.TacGiaOptions)
                        {
                            <option value="@tacGia" selected="@(ViewBag.TacGia as string == tacGia)">@tacGia</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold">Trạng thái sách</label>
                    <select name="trangThai" class="form-select" asp-items="statuses"><option value="">Tất cả</option></select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold">Năm xuất bản</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="namTu" value="@ViewBag.NamTu" class="form-control" placeholder="Từ" min="1900" max="2100" />
                        <input type="number" name="namDen" value="@ViewBag.NamDen" class="form-control" placeholder="Đến" min="1900" max="2100" />
                    </div>
                </div>
                <div class="col-lg-1 col-md-6 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a asp-action="Index" id="nut-xoa-loc" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    @* Vùng kết quả được thay bằng partial _BangSach khi lọc/tìm kiếm/phân trang qua AJAX *@
    <div id="vung-ket-qua-sach">
        <partial name="_BangSach" model="Model" />
    </div>
</div>

@section Scripts {
<script>
    // Lọc/tìm kiếm/phân trang bằng AJAX: server trả về partial _BangSach (header X-Requested-With),
    // JS chỉ thay vùng kết quả; URL vẫn cập nhật để chia sẻ và nút Back hoạt động.
    (function () {
        var vung = document.getElementById('vung-ket-qua-sach');
        var form = document.getElementById('bo-loc-sach');
        if (!vung || !form) return;

        function nap(url, push) {
            vung.style.opacity = '0.55';
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    vung.innerHTML = html;
                    vung.style.opacity = '1';
                    if (push) history.pushState(null, '', url);
                })
                .catch(function () { vung.style.opacity = '1'; });
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            nap(form.getAttribute('action') + '?' + new URLSearchParams(new FormData(form)).toString(), true);
        });

        form.addEventListener('click', function (e) {
            var a = e.target.closest('a[href]');
            if (!a) return;
            e.preventDefault();
            // Xóa lọc: dọn trắng các ô nhập/select (giữ input ẩn pageSize) rồi nạp lại danh sách
            if (a.id === 'nut-xoa-loc') {
                form.querySelectorAll('input[name], select[name]').forEach(function (el) {
                    if (el.type !== 'hidden') el.value = '';
                });
            }
            nap(a.getAttribute('href'), true);
        });

        vung.addEventListener('click', function (e) {
            var a = e.target.closest('a[href]');
            if (!a || !a.closest('.phan-trang')) return;
            e.preventDefault();
            nap(a.getAttribute('href'), true);
        });

        window.addEventListener('popstate', function () { nap(location.href, false); });
    })();
</script>
}
