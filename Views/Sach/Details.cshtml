@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xây dựng view cho việc xem chi tiết sách (Admin, Thủ thư) *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chi tiết sách";
}
@inject QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.ICurrentUserService Current
@{
    var isStaff = Current.IsAuthenticated && Current.IsInRole(VaiTro.Admin, VaiTro.ThuThu);
}
<div class="app-form-card app-detail-card @(isStaff ? "app-detail-card--staff" : "")">
    <div class="app-form-header">
        <h1>@(isStaff ? "Chi tiết sách" : Model.TenSach)</h1>
        <a asp-action="@(isStaff ? "Index" : "Catalog")" class="btn app-btn-soft ms-auto">← Quay lại</a>
    </div>
    <partial name="_AlertsPartial" />
    <div class="app-detail-content">
        <div class="app-detail-cover">
            @if (!string.IsNullOrWhiteSpace(Model.ImgPath))
            { <img src="@Model.ImgPath" alt="Bìa sách @Model.TenSach" /> }
            else { <strong>@Model.TenSach</strong><span>@Model.TacGia</span> }
        </div>
        <div class="app-detail-info">
            <dl class="app-detail-grid">
                <dt>Tên sách</dt><dd>@Model.TenSach</dd>
                <dt>Tác giả</dt><dd>@Model.TacGia</dd>
                <dt>Thể loại</dt><dd>@Model.TenTheLoai</dd>
                <dt>Nhà xuất bản</dt><dd>@(Model.NhaXuatBan ?? "—")</dd>
                <dt>Năm xuất bản</dt><dd>@Model.NamXuatBan</dd>
                <dt>Tổng số lượng</dt><dd>@Model.SoLuongTong</dd>
                <dt>Còn lại</dt><dd>@Math.Max(0, Model.SoLuongConLai)</dd>
                <dt>Giá bìa</dt><dd>@Model.GiaBia.ToString("N0") ₫</dd>
                <dt>Vị trí kệ</dt><dd>@(Model.ViTriKe ?? "—")</dd>
                <dt class="app-detail-span">Mô tả</dt><dd class="app-detail-span">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "—" : Model.MoTa)</dd>
            </dl>
        </div>
    </div>
    @if (isStaff)
    {
        <div class="app-form-footer app-detail-actions">
            <a asp-action="Edit" asp-route-id="@Model.MaSach" class="btn app-btn-soft">Sửa</a>
            @if (Model.TrangThai is TrangThaiSach.DangPhucVu or TrangThaiSach.TamNgung)
            {
                <form asp-action="ToggleTrangThai" asp-route-id="@Model.MaSach" method="post" class="d-inline"
                      onsubmit="return confirm('Đổi trạng thái phục vụ của sách này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn app-btn-soft">@(Model.TrangThai == TrangThaiSach.DangPhucVu ? "Tạm ngưng" : "Mở lại")</button>
                </form>
            }
            <a asp-action="Delete" asp-route-id="@Model.MaSach" class="btn btn-outline-danger">Xóa</a>
        </div>
    }
    else
    {
        <div class="borrow-panel surface-card">
        @if (Model.TrangThai == TrangThaiSach.DangPhucVu)
        {
            @if (Current.IsInRole(VaiTro.BanDoc))
            {
                <form asp-controller="PhieuMuon" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maSach" value="@Model.MaSach" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú khi đăng ký</label>
                        <textarea name="ghiChu" class="form-control" rows="3" maxlength="100" placeholder="Ví dụ: cần lấy sách vào buổi chiều"></textarea>
                    </div>
                    <button class="btn btn-primary w-100 btn-lg" type="submit">Đăng ký mượn sách</button>
                </form>
            }
            else if (!Current.IsAuthenticated)
            {
                <a asp-controller="TaiKhoan" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-primary w-100 btn-lg">Đăng nhập để đăng ký mượn</a>
            }
            else
            {
                <div class="alert alert-light border mb-0">Tài khoản nhân viên sử dụng chức năng quản lý phiếu mượn.</div>
            }
        }
        else
        {
            <button class="btn btn-secondary w-100" disabled>Hiện không thể mượn</button>
        }
        <small class="text-muted d-block mt-3">Thời hạn mượn mặc định: 14 ngày. Thủ thư sẽ xác nhận trước khi giao sách.</small>
        </div>
    }
</div>
