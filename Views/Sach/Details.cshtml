@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xây dựng view cho việc xem chi tiết sách (Admin, Thủ thư) *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chi tiết sách";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1 class="h4 mb-3">Chi tiết sách</h1>
        @if (TempData["ThongBao"] is string notice) { <div class="alert alert-success">@notice</div> }
        @if (TempData["Loi"] is string error) { <div class="alert alert-danger">@error</div> }
        <dl class="row">
            <dt class="col-sm-4">Tên sách</dt><dd class="col-sm-8">@Model.TenSach</dd>
            <dt class="col-sm-4">Tác giả</dt><dd class="col-sm-8">@Model.TacGia</dd>
            <dt class="col-sm-4">Thể loại</dt><dd class="col-sm-8">@Model.TenTheLoai</dd>
            <dt class="col-sm-4">Nhà xuất bản</dt><dd class="col-sm-8">@Model.NhaXuatBan</dd>
            <dt class="col-sm-4">Năm xuất bản</dt><dd class="col-sm-8">@Model.NamXuatBan</dd>
            <dt class="col-sm-4">Số lượng</dt><dd class="col-sm-8">@Model.SoLuongTong</dd>
            <dt class="col-sm-4">Giá bìa</dt><dd class="col-sm-8">@Model.GiaBia.ToString("N0") đ</dd>
            <dt class="col-sm-4">Vị trí kệ</dt><dd class="col-sm-8">@Model.ViTriKe</dd>
            <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@Model.TrangThai.GetDisplayName()</dd>
            <dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8">@Model.MoTa</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.ImgPath))
        {
            <img src="@Model.ImgPath" alt="Bìa sách @Model.TenSach" class="img-fluid mb-3" />
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Trang chủ</a>
    </div>
</div>
