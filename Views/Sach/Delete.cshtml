@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xác nhận xóa sách theo mẫu library_demo - 2 khả năng, 1 card, footer phải *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachDetail
@{
    ViewData["Title"] = "Xóa sách";
}
<div class="app-form-card">
    <div class="app-form-header">
        <h1>Xóa sách</h1>
    </div>
    <div class="app-form-footer">
        <a asp-action="Details" asp-route-id="@Model.MaSach" class="btn app-btn-soft">Hủy</a>
        <form id="formXoaSach" asp-action="Delete" asp-route-id="@Model.MaSach" method="post" class="d-inline" data-ajax-crud="form">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-danger"
                    data-confirm-form="#formXoaSach"
                    data-confirm-title="Xác nhận xóa sách"
                    data-confirm-message="Bạn có chắc chắn muốn xóa sách '@Model.TenSach'? Sách chưa từng mượn sẽ bị xóa thật; sách đã có lịch sử mượn sẽ chuyển sang Ngừng phục vụ."
                    data-confirm-ok="Xóa sách"
                    data-confirm-class="btn-danger">Xóa</button>
        </form>
    </div>
</div>
