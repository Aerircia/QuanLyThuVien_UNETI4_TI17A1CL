@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Trang xác nhận xóa sách, cấu trúc đồng bộ với các view BanDoc, xác nhận bằng _ConfirmModal *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachDetail
@{
    ViewData["Title"] = "Xóa sách";
}
<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h4 mb-0">Xóa sách</h1>
                <a asp-action="Details" asp-route-id="@Model.MaSach" class="btn btn-outline-secondary">← Quay lại</a>
            </div>

            <partial name="_AlertsPartial" />

            <div class="app-card">
                <div class="alert alert-warning" role="alert">
                    <h6 class="alert-heading fw-bold mb-1">Bạn sắp xóa sách này</h6>
                    <div class="small">
                        Sách chưa từng mượn sẽ bị xóa hẳn. Sách đã có lịch sử mượn sẽ chuyển sang <strong>Ngừng phục vụ</strong> để giữ dữ liệu.
                        Không thể xóa khi còn phiếu mượn đang hiệu lực.
                    </div>
                </div>

                <div class="row g-3 small">
                    <div class="col-sm-6"><small class="text-muted d-block">Tên sách</small><span class="fw-semibold">@Model.TenSach</span></div>
                    <div class="col-sm-6"><small class="text-muted d-block">Tác giả</small><span>@Model.TacGia</span></div>
                    <div class="col-sm-6"><small class="text-muted d-block">Thể loại</small><span>@Model.TenTheLoai</span></div>
                    <div class="col-sm-6"><small class="text-muted d-block">Số lượng tổng</small><span>@Model.SoLuongTong</span></div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <a asp-action="Details" asp-route-id="@Model.MaSach" class="btn btn-outline-secondary">Hủy</a>
                    <form id="formXoaSach" asp-action="Delete" asp-route-id="@Model.MaSach" method="post" class="d-inline" data-ajax-crud="form">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-danger px-4"
                                data-confirm-form="#formXoaSach"
                                data-confirm-title="Xác nhận xóa sách"
                                data-confirm-message="Bạn có chắc chắn muốn xóa sách '@Model.TenSach'?"
                                data-confirm-ok="Xóa sách"
                                data-confirm-class="btn-danger">Xóa sách</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
