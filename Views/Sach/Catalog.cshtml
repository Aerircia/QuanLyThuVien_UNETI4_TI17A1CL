@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.SachListItem>
@{
    ViewData["Title"] = "Kho sách";
}
<div class="page-heading">
    <div><span class="text-uppercase text-muted small fw-bold">Khám phá thư viện</span><h1>Kho sách</h1><p>Tìm kiếm và đăng ký mượn đầu sách bạn quan tâm.</p></div>
</div>
<form method="get" class="surface-card filter-card mb-4">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tên sách, tác giả hoặc nhà xuất bản..." />
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    </div>
</form>
<div class="book-grid">
@foreach (var book in Model.Items)
{
    <a asp-action="Details" asp-route-id="@book.MaSach" class="book-card">
        <div class="book-cover"><small>@book.TenTheLoai</small><strong>@book.TenSach</strong></div>
        <div class="book-card-body"><h2>@book.TenSach</h2><div class="author">@book.TacGia</div><small class="text-muted">@book.SoLuongTong cuốn · @book.NamXuatBan</small></div>
    </a>
}
</div>
@if (!Model.Items.Any()) { <div class="surface-card p-5 text-center text-muted">Không tìm thấy sách phù hợp.</div> }
