@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Hiển thị form sửa sách đã điền sẵn cùng xác thực, lưu thay đổi và nút hủy. *@

@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.SachFormViewModel
@{
    ViewData["Title"] = "Sửa sách";
}
<partial name="_SachAlerts" />
<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-3">Sửa sách</h1>
        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_SachForm" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
