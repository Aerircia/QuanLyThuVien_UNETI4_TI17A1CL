@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: view quản lý thông báo của hệ thống: tìm/lọc/phân trang bằng AJAX, ẩn/hiện có modal xác nhận *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.QuanLyThongBaoViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Notifications
@{
    ViewData["Title"] = "Quản lý thông báo";
    var dangLoc = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.Loai)
                  || !string.IsNullOrEmpty(Model.NhomNhan) || Model.DangHienThi.HasValue;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">Quản lý thông báo</h1>
    <div class="d-flex gap-2">
        <a asp-controller="ThongBao" asp-action="Index" class="btn btn-outline-secondary">Hộp thư của tôi</a>
        <a asp-action="Gui" class="btn btn-primary">Gửi thông báo</a>
    </div>
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger" role="alert">@loi</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form id="bo-loc-quan-ly" method="get" asp-action="Index" class="row g-2 align-items-center" data-ajax-filter-form>
            <input type="hidden" id="pageSize" name="pageSize" value="@Model.PageSize" />
            <div class="col-lg-4">
                <input id="timKiem" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tiêu đề, nội dung, người nhận" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350" />
            </div>
            <div class="col-md-4 col-lg-2">
                <select id="loai" name="loai" class="form-select">
                    <option value="">Tất cả loại</option>
                    @foreach (var ma in ThongBaoHienThi.CacLoai)
                    {
                        <option value="@ma" selected="@(Model.Loai == ma)">@ThongBaoHienThi.TenLoai(ma)</option>
                    }
                </select>
            </div>
            <div class="col-md-4 col-lg-2">
                <select id="nhomNhan" name="nhomNhan" class="form-select">
                    <option value="">Mọi người nhận</option>
                    <option value="BanDoc" selected="@(Model.NhomNhan == "BanDoc")">Bạn đọc</option>
                    <option value="NhanVien" selected="@(Model.NhomNhan == "NhanVien")">Thủ thư / Admin</option>
                </select>
            </div>
            <div class="col-md-4 col-lg-2">
                <select id="hienThi" name="hienThi" class="form-select">
                    <option value="">Hiển thị: tất cả</option>
                    <option value="true" selected="@(Model.DangHienThi == true)">Đang hiện</option>
                    <option value="false" selected="@(Model.DangHienThi == false)">Đã ẩn</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <a asp-action="Index" data-xoa-loc data-ajax-clear class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<div id="vung-ket-qua-quan-ly" data-ajax-list data-ajax-form="#bo-loc-quan-ly" data-ajax-change>
    <partial name="_BangQuanLy" model="Model" />
</div>
