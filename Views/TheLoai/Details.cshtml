@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Chi tiết thể loại theo mẫu library_demo - 1 card, header + Quay lại, footer phải *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chi tiết thể loại";
}
<div class="app-form-card">
    <div class="app-form-header">
        <h1>Chi tiết thể loại</h1>
        <span class="badge @(Model.TrangThai == TrangThaiTheLoai.HoatDong ? "badge-soft-success" : "badge-soft-secondary")">@Model.TrangThai.GetDisplayName()</span>
        <a asp-action="Index" class="btn app-btn-soft ms-auto">← Quay lại</a>
    </div>
    <partial name="_AlertsPartial" />
    <dl class="row mb-0">
        <dt class="col-sm-5">Mã thể loại</dt><dd class="col-sm-7">TL@(Model.MaTheLoai.ToString("D2"))</dd>
        <dt class="col-sm-5">Tên thể loại</dt><dd class="col-sm-7">@Model.TenTheLoai</dd>
        <dt class="col-sm-5">Khu vực lưu trữ</dt><dd class="col-sm-7">@(Model.KhuVucLuuTru ?? "—")</dd>
        <dt class="col-sm-5">Mô tả</dt><dd class="col-sm-7">@(Model.MoTa ?? "—")</dd>
    </dl>
</div>
