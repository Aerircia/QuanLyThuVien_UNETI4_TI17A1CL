@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xây dựng view cho việc xem chi tiết thể loại (Admin) *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chi tiết thể loại";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4 mb-3">Chi tiết thể loại</h1>
        @if (TempData["ThongBao"] is string notice) { <div class="alert alert-success">@notice</div> }
        @if (TempData["Loi"] is string error) { <div class="alert alert-danger">@error</div> }
        <dl class="row">
            <dt class="col-sm-4">Tên thể loại</dt><dd class="col-sm-8">@Model.TenTheLoai</dd>
            <dt class="col-sm-4">Khu vực lưu trữ</dt><dd class="col-sm-8">@Model.KhuVucLuuTru</dd>
            <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@Model.TrangThai.GetDisplayName()</dd>
            <dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8">@Model.MoTa</dd>
        </dl>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Trang chủ</a>
    </div>
</div>
