@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: View liệt kê thể loại (Admin), cấu trúc đồng bộ với BanDoc/Index *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiListItem>
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    ViewData["Title"] = "Quản lý thể loại";
    var statuses = Html.GetEnumSelectList<TrangThaiTheLoai>().ToList();
    foreach (var option in statuses)
        option.Selected = ViewBag.TrangThai is TrangThaiTheLoai selected && option.Value == ((int)selected).ToString();
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Quản lý thể loại</h1>
            <p class="text-muted small mb-0">Phân loại sách và khu vực lưu trữ trên giá.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Thêm thể loại</a>
    </div>

    <partial name="_AlertsPartial" />

    <!-- Bộ lọc tìm kiếm -->
    <div class="card mb-3">
        <div class="card-body">
            <form id="bo-loc-the-loai" method="get" asp-action="Index" class="row g-2 align-items-center">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-md-5">
                    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, mô tả hoặc khu vực lưu trữ..." data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350" />
                </div>
                <div class="col-md-4">
                    <select name="trangThai" class="form-select" asp-items="statuses"><option value="">Tất cả trạng thái</option></select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <a asp-action="Index" id="nut-xoa-loc-the-loai" data-ajax-clear class="btn btn-outline-secondary flex-fill">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    @* Vùng kết quả được thay bằng partial _BangTheLoai khi lọc/tìm kiếm/phân trang qua AJAX *@
    <div id="vung-ket-qua-the-loai" data-ajax-list data-ajax-form="#bo-loc-the-loai" data-ajax-change>
        <partial name="_BangTheLoai" model="Model" />
    </div>
</div>
