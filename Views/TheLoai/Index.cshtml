@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xây dựng view cho việc liệt kê thể loại (Admin) *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiListItem>
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    ViewData["Title"] = "Quản lý thể loại";
    var statuses = Html.GetEnumSelectList<TrangThaiTheLoai>().ToList();
    foreach (var option in statuses)
        option.Selected = ViewBag.TrangThai is TrangThaiTheLoai selected && option.Value == ((int)selected).ToString();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Quản lý thể loại</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm thể loại</a>
</div>
@if (TempData["ThongBao"] is string notice) { <div class="alert alert-success">@notice</div> }
@if (TempData["Loi"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tên, mô tả hoặc khu vực lưu trữ" /></div>
    <div class="col-md-4"><select name="trangThai" class="form-select" asp-items="statuses"><option value="">Mọi trạng thái</option></select></div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary">Lọc</button></div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Tên thể loại</th><th>Khu vực</th><th>Số sách</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var category in Model.Items)
        {
            <tr>
                <td>@category.TenTheLoai</td><td>@category.KhuVucLuuTru</td><td>@category.SoLuongSach</td>
                <td>@category.TrangThai.GetDisplayName()</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@category.MaTheLoai" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@category.MaTheLoai" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@category.MaTheLoai" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Items.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Không tìm thấy thể loại phù hợp.</td></tr> }
        </tbody>
    </table>
</div>
<partial name="_PagerPartial" model="(PagerViewModel)ViewBag.Pager" />
