@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Form thêm thể loại theo mẫu library_demo - 1 card, header + Quay lại, footer phải *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Models.TheLoai
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Thêm thể loại";
}
<div class="app-form-card">
    <div class="app-form-header">
        <h1>Thêm thể loại</h1>
        <a asp-action="Index" class="btn app-btn-soft">← Quay lại</a>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="TenTheLoai" class="form-label">Tên thể loại <span class="text-danger">*</span></label>
            <input asp-for="TenTheLoai" class="form-control" />
            <span asp-validation-for="TenTheLoai" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="KhuVucLuuTru" class="form-label">Khu vực lưu trữ (tối đa 100 ký tự)</label>
            <input asp-for="KhuVucLuuTru" class="form-control" placeholder="VD: Khu A" />
            <span asp-validation-for="KhuVucLuuTru" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoTa" class="form-label">Mô tả</label>
            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            <span asp-validation-for="MoTa" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" asp-items="Html.GetEnumSelectList<TrangThaiTheLoai>()" class="form-select"></select>
        </div>

        <div class="app-form-footer">
            <a asp-action="Index" class="btn app-btn-soft">Hủy</a>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
