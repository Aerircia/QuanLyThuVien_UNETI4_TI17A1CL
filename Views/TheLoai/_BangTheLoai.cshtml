@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Partial bảng + phân trang thể loại, dùng cho render thường và AJAX; bảng/nút/badge theo BanDoc/Index *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiListItem>
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="table-responsive admin-table-card rtb">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên thể loại</th>
                <th>Khu vực lưu trữ</th>
                <th class="text-end">Số đầu sách</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var category in Model.Items)
        {
            var hoatDong = category.TrangThai == TrangThaiTheLoai.HoatDong;
            <tr>
                <td data-label="Mã" class="text-muted font-monospace">TL@(category.MaTheLoai.ToString("D2"))</td>
                <td data-label="Tên thể loại">
                    <a asp-action="Details" asp-route-id="@category.MaTheLoai" class="fw-bold text-decoration-none text-dark">@category.TenTheLoai</a>
                </td>
                <td data-label="Khu vực lưu trữ">@(category.KhuVucLuuTru ?? "—")</td>
                <td data-label="Số đầu sách" class="text-end">@category.SoLuongSach</td>
                <td data-label="Trạng thái">
                    <span class="badge @(hoatDong ? "badge-soft-success" : "badge-soft-secondary")">@category.TrangThai.GetDisplayName()</span>
                </td>
                <td data-label="" class="text-end text-nowrap khong-nhan">
                    <a asp-action="Edit" asp-route-id="@category.MaTheLoai" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="ToggleTrangThai" asp-route-id="@category.MaTheLoai" asp-route-returnUrl="@returnUrl" method="post"
                          class="d-inline" id="toggleTheLoaiForm-@category.MaTheLoai" data-ajax-crud="form">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-sm @(hoatDong ? "btn-outline-danger" : "btn-outline-primary")"
                                data-confirm-form="#toggleTheLoaiForm-@category.MaTheLoai"
                                data-confirm-title="@(hoatDong ? "Ngưng hoạt động thể loại" : "Kích hoạt lại thể loại")"
                                data-confirm-message="@(hoatDong ? $"Bạn có chắc muốn ngưng hoạt động thể loại '{category.TenTheLoai}'?" : $"Bạn có chắc muốn kích hoạt lại thể loại '{category.TenTheLoai}'?")"
                                data-confirm-ok="@(hoatDong ? "Ngưng hoạt động" : "Kích hoạt")"
                                data-confirm-class="@(hoatDong ? "btn-danger" : "btn-primary")">@(hoatDong ? "Ngưng" : "Kích hoạt")</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@category.MaTheLoai" method="post" class="d-none" id="xoaTheLoai-@category.MaTheLoai">
                        @Html.AntiForgeryToken()
                    </form>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            data-confirm-form="#xoaTheLoai-@category.MaTheLoai"
                            data-confirm-title="Xóa thể loại"
                            data-confirm-message="@($"• Thể loại còn sách → không thể xóa; hãy chuyển sách sang thể loại khác trước.\n• Thể loại trống → xóa vĩnh viễn, không thể khôi phục.\n\nCó xác nhận xóa thể loại không?")"
                            data-confirm-ok="Xóa thể loại"
                            data-confirm-class="btn-danger">Xóa</button>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy thể loại phù hợp.</td></tr>
        }
        </tbody>
    </table>
</div>
<div class="phan-trang mt-3">
    <partial name="_PagerPartial" model="(PagerViewModel)ViewBag.Pager" />
</div>
