@* Nội dung thực hiện: Xác nhận xóa thể loại theo mẫu library_demo *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiDetail
@{
    ViewData["Title"] = "Xóa thể loại";
}
<div class="app-form-card">
    <div class="app-form-header">
        <h1>Xóa thể loại</h1>
    </div>
    <div class="app-form-footer">
        <a asp-action="Details" asp-route-id="@Model.MaTheLoai" class="btn app-btn-soft">Hủy</a>
        <form id="formXoaTheLoai" asp-action="Delete" asp-route-id="@Model.MaTheLoai" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-danger"
                    data-confirm-form="#formXoaTheLoai"
                    data-confirm-title="Xác nhận xóa thể loại"
                    data-confirm-message="Bạn có chắc chắn muốn xóa thể loại '@Model.TenTheLoai'? Thể loại đang có sách sẽ không thể xóa."
                    data-confirm-ok="Xóa thể loại"
                    data-confirm-class="btn-danger">Xóa</button>
        </form>
    </div>
</div>
