@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: Xây dựng view cho việc xóa thể loại (Admin) *@

@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.TheLoaiDetail
@{
    ViewData["Title"] = "Xóa thể loại";
}
<h1 class="h4 mb-3">Xóa thể loại</h1>
<div class="alert alert-warning">Bạn có chắc muốn xóa thể loại <strong>@Model.TenTheLoai</strong> không? Thể loại đang có sách sẽ không thể xóa.</div>
<form asp-action="Delete" asp-route-id="@Model.MaTheLoai" method="post">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Details" asp-route-id="@Model.MaTheLoai" class="btn btn-outline-secondary">Hủy</a>
</form>
