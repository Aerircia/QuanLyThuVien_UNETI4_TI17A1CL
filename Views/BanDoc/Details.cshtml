@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View chi tiết thông tin bạn đọc, duyệt thẻ và lịch sử mượn trả (Thủ thư & Admin) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chi tiết bạn đọc - " + Model.HoTen;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isChoDuyet = Model.TrangThai == TrangThaiBanDoc.ChoDuyet;
    var isIssued = Model.TrangThai is TrangThaiBanDoc.HoatDong or TrangThaiBanDoc.NgungHoatDong;
    var locked = Model.TrangThai == TrangThaiBanDoc.NgungHoatDong;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Hồ sơ bạn đọc: @Model.HoTen</h1>
            <span class="text-muted small font-monospace">Mã bạn đọc #@Model.MaBanDoc · Mã số thẻ: @(Model.MaSoThe ?? "Chưa cấp")</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Danh sách</a>
            @if (isIssued)
            {
                <a asp-action="Edit" asp-route-id="@Model.MaBanDoc" class="btn btn-outline-primary btn-sm">Sửa hồ sơ</a>
                <form asp-action="SetStatus" method="post" class="d-inline" id="statusBanDocDetails">
                    <input type="hidden" name="id" value="@Model.MaBanDoc" />
                    <input type="hidden" name="trangThai" value="@(locked ? nameof(TrangThaiBanDoc.HoatDong) : nameof(TrangThaiBanDoc.NgungHoatDong))" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="button" class="btn btn-sm @(locked ? "btn-outline-primary" : "btn-outline-danger")"
                            data-confirm-form="#statusBanDocDetails"
                            data-confirm-title="@(locked ? "Mở khóa bạn đọc" : "Tạm khóa bạn đọc")"
                            data-confirm-message="Bạn có chắc muốn @(locked ? "kích hoạt lại" : "tạm khóa") bạn đọc này?"
                            data-confirm-ok="@(locked ? "Mở khóa" : "Tạm khóa")"
                            data-confirm-class="@(locked ? "btn-primary" : "btn-danger")">

                        @(locked ? "Mở khóa" : "Tạm khóa")
                    </button>
                </form>
            }
        </div>
    </div>

    <partial name="_AlertsPartial" />

    <!-- Banner hành động khi hồ sơ đang Chờ duyệt -->
    @if (isChoDuyet)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4" role="alert">
            <div>
                <h6 class="alert-heading fw-bold mb-1">
                    <span class="badge badge-soft-warning me-2">Chờ duyệt</span> Hồ sơ đăng ký thẻ bạn đọc đang chờ xét duyệt
                </h6>
                <div class="small">
                    Bạn đọc đã hoàn tất điền thông tin đăng ký cấp thẻ thư viện. Hãy kiểm tra thông tin và thực hiện phê duyệt để kích hoạt thẻ.
                </div>
            </div>
            <div class="d-flex gap-2">
                <form asp-action="Duyet" method="post" class="d-inline" id="duyetTheDetails">
                    <input type="hidden" name="id" value="@Model.MaBanDoc" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="button" class="btn btn-primary"
                            data-confirm-form="#duyetTheDetails"
                            data-confirm-title="Duyệt cấp thẻ bạn đọc"
                            data-confirm-message="Xác nhận duyệt cấp thẻ thư viện cho bạn đọc @Model.HoTen?"
                            data-confirm-ok="Duyệt cấp thẻ"
                            data-confirm-class="btn-primary">

                        Duyệt cấp thẻ
                    </button>
                </form>
                <form asp-action="TuChoi" method="post" class="d-inline" id="tuChoiTheDetails">
                    <input type="hidden" name="id" value="@Model.MaBanDoc" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="button" class="btn btn-outline-danger"
                            data-confirm-form="#tuChoiTheDetails"
                            data-confirm-title="Từ chối cấp thẻ bạn đọc"
                            data-confirm-message="Xác nhận từ chối yêu cầu cấp thẻ của bạn đọc @Model.HoTen?"
                            data-confirm-ok="Từ chối"
                            data-confirm-class="btn-danger">

                        Từ chối
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Model.TrangThai == TrangThaiBanDoc.TuChoi)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <span class="badge badge-soft-danger me-2">Từ chối</span> Yêu cầu cấp thẻ đã bị từ chối. Bạn đọc có thể chỉnh sửa và gửi lại yêu cầu.
        </div>
    }

    <div class="row g-3 mb-4">
        <!-- Card thẻ thư viện -->
        <div class="col-lg-4">
            <div class="library-card-widget mb-3">
                <div class="card-sub">THẺ BẠN ĐỌC THƯ VIỆN</div>
                <div class="card-code">@(Model.MaSoThe ?? "CHƯA CẤP")</div>
                <div class="card-name">@Model.HoTen</div>
                <div class="card-meta d-flex justify-content-between">
                    <span>@Model.LoaiBanDoc.GetDisplayName()</span>
                    <span>Hạn: @Model.NgayHetHanThe.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-bold">Tóm tắt tình trạng</div>
                <div class="card-body">
                    <div class="list-group list-group-flush small">
                        <div class="list-group-item d-flex justify-content-between px-0">
                            <span>Trạng thái hồ sơ:</span>
                            <span class="badge @(Model.TrangThai switch {
                                TrangThaiBanDoc.HoatDong => "badge-soft-success",
                                TrangThaiBanDoc.ChoDuyet => "badge-soft-warning",
                                TrangThaiBanDoc.TuChoi => "badge-soft-danger",
                                TrangThaiBanDoc.NgungHoatDong => "badge-soft-danger",
                                _ => "badge-soft-secondary"
                            })">@Model.TrangThai.GetDisplayName()</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0">
                            <span>Hạn thẻ thư viện:</span>
                            <span class="@(Model.TheHetHan ? "text-danger fw-bold" : "text-dark")">
                                @Model.NgayHetHanThe.ToString("dd/MM/yyyy")
                                @(Model.TheHetHan ? "(Hết hạn)" : "")
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0">
                            <span>Số sách đang mượn:</span>
                            <span class="fw-bold text-primary">@Model.SoPhieuDangMuon</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0">
                            <span>Số phiếu quá hạn:</span>
                            <span class="fw-bold @(Model.SoPhieuQuaHan > 0 ? "text-danger" : "text-muted")">@Model.SoPhieuQuaHan</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0">
                            <span>Tiền phạt chưa nộp:</span>
                            <span class="fw-bold @(Model.TongTienPhatChuaNop > 0 ? "text-danger" : "text-muted")">@Model.TongTienPhatChuaNop.ToString("N0") ₫</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết thông tin cá nhân -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header fw-bold">Thông tin chi tiết</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Họ và tên</small>
                            <span class="fw-semibold">@Model.HoTen</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Tên đăng nhập hệ thống</small>
                            <span>@(Model.TenDangNhap ?? "—")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Ngày sinh</small>
                            <span>@Model.NgaySinh.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Giới tính</small>
                            <span>@Model.GioiTinh.GetDisplayName()</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Số điện thoại</small>
                            <span>@(Model.SoDienThoai ?? "—")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Email</small>
                            <span>@(Model.Email ?? "—")</span>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Địa chỉ</small>
                            <span>@(Model.DiaChi ?? "—")</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Loại bạn đọc</small>
                            <span>@Model.LoaiBanDoc.GetDisplayName()</span>
                        </div>
                        <div class="col-sm-3">
                            <small class="text-muted d-block">Ngày cấp thẻ</small>
                            <span>@Model.NgayCapThe.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-sm-3">
                            <small class="text-muted d-block">Ngày hết hạn thẻ</small>
                            <span>@Model.NgayHetHanThe.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch sử phiếu mượn & phạt -->
    <div class="card">
        <div class="card-header p-0">
            <ul class="nav nav-tabs nav-fill border-bottom-0" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-loans" type="button">
                        Lịch sử phiếu mượn (@Model.PhieuMuons.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-fines" type="button">
                        Lịch sử phạt (@Model.KhoanPhats.Count)
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content p-3">
            <!-- Tab phiếu mượn -->
            <div class="tab-pane fade show active" id="tab-loans" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tên sách</th>
                                <th>Thể loại</th>
                                <th>Ngày đăng ký</th>
                                <th>Ngày mượn</th>
                                <th>Hạn trả</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PhieuMuons)
                            {
                                <tr>
                                    <td>#@p.MaPhieuMuon</td>
                                    <td>
                                        <div class="fw-semibold">@p.TenSach</div>
                                        <small class="text-muted">@p.TacGia</small>
                                    </td>
                                    <td>@(p.TheLoai ?? "—")</td>
                                    <td>@p.NgayDangKy.ToString("dd/MM/yyyy")</td>
                                    <td>@(p.NgayMuon?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>
                                        @if (p.HanTra.HasValue)
                                        {
                                            <span class="@(p.IsOverdue ? "text-danger fw-bold" : "")">
                                                @p.HanTra.Value.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (p.IsOverdue)
                                            {
                                                <span class="badge badge-soft-danger ms-1">Trễ @p.SoNgayQuaHan ngày</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(p.TrangThai switch {
                                            TrangThaiPhieuMuon.ChoDuyet => "badge-soft-warning",
                                            TrangThaiPhieuMuon.DaDuyet  => "badge-soft-info",
                                            TrangThaiPhieuMuon.DangMuon => p.IsOverdue ? "badge-soft-danger" : "badge-soft-primary",
                                            TrangThaiPhieuMuon.DaTra    => "badge-soft-success",
                                            TrangThaiPhieuMuon.TuChoi   => "badge-soft-danger",
                                            _                           => "badge-soft-secondary"
                                        })">
                                            @p.TrangThai.GetDisplayName()
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="QuanLyPhieuMuon" asp-action="Details" asp-route-id="@p.MaPhieuMuon" class="btn btn-sm btn-outline-primary">
                                            Xem
                                        </a>
                                    </td>
                                </tr>
                            }

                            @if (!Model.PhieuMuons.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">Bạn đọc chưa có phiếu mượn nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab tiền phạt -->
            <div class="tab-pane fade" id="tab-fines" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Phiếu mượn</th>
                                <th>Sách</th>
                                <th>Ngày trả</th>
                                <th>Tình trạng sách</th>
                                <th>Số ngày trễ</th>
                                <th class="text-end">Tiền phạt</th>
                                <th>Trạng thái nộp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.KhoanPhats)
                            {
                                <tr>
                                    <td>#@f.MaPhieuMuon</td>
                                    <td>@f.TenSach</td>
                                    <td>@f.NgayTra.ToString("dd/MM/yyyy")</td>
                                    <td>@f.TinhTrangSach.GetDisplayName()</td>
                                    <td>@f.SoNgayTre ngày</td>
                                    <td class="text-end fw-bold text-danger">@f.TienPhat.ToString("N0") ₫</td>
                                    <td>
                                        <span class="badge @(f.TrangThaiPhat == TrangThaiPhat.DaNop ? "badge-soft-success" : "badge-soft-danger")">
                                            @f.TrangThaiPhat.GetDisplayName()
                                        </span>
                                    </td>
                                </tr>
                            }

                            @if (!Model.KhoanPhats.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">Bạn đọc không có khoản phạt nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
