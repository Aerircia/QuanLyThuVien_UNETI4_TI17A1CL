@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Duyệt thẻ bạn đọc";
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h4 mb-0">Duyệt thẻ bạn đọc</h1>
                <span id="pendingCountBadge" class="badge badge-soft-warning">@Model.Result.TotalCount yêu cầu chờ duyệt</span>
            </div>
            <p class="text-muted small mb-0">Phê duyệt cấp mã số thẻ thư viện hoặc từ chối các yêu cầu mở thẻ mới từ bạn đọc.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                ← Danh sách tất cả bạn đọc
            </a>
        </div>
    </div>

    <partial name="_AlertsPartial" />

    <div id="duyetTheContainer">
        <partial name="_DuyetTheContentPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
    (() => {
        const container = document.getElementById('duyetTheContainer');
        const badge = document.getElementById('pendingCountBadge');
        if (!container) return;

        let currentUrl = window.location.href;

        const syncBadge = () => {
            const meta = document.getElementById('duyetTheMeta');
            if (meta && badge) {
                const count = meta.dataset.totalCount || '0';
                badge.textContent = `${count} yêu cầu chờ duyệt`;
            }
        };

        const showAlert = (message, type = 'success') => {
            const alertBox = document.getElementById('duyetTheAlertContainer');
            if (!alertBox) return;
            alertBox.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        const loadContent = async (url, pushState = true) => {
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Network error');
                const html = await res.text();
                container.innerHTML = html;
                currentUrl = url;
                syncBadge();
                if (pushState) {
                    history.pushState(null, '', url);
                }
            } catch (err) {
                console.error('Failed to load duyet the content', err);
                window.location.href = url;
            }
        };

        // Click phân trang hoặc xóa tìm kiếm bằng AJAX
        container.addEventListener('click', (e) => {
            const link = e.target.closest('.pagination a, a.duyet-the-link');
            if (link && link.href) {
                e.preventDefault();
                loadContent(link.href);
            }
        });

        // Tìm kiếm bằng AJAX
        container.addEventListener('submit', (e) => {
            const form = e.target.closest('#duyetTheSearchForm');
            if (form) {
                e.preventDefault();
                const formData = new FormData(form);
                const params = new URLSearchParams(formData);
                const url = `${form.action}?${params.toString()}`;
                loadContent(url);
            }
        });

        // Xử lý phê duyệt / từ chối thẻ qua AJAX (sau khi bấm xác nhận trên modal)
        document.addEventListener('submit', async (e) => {
            const form = e.target.closest('.card-approval-form');
            if (!form) return;

            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const res = await fetch(form.action, {
                    method: form.method || 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json, text/html;q=0.9'
                    }
                });

                const data = await res.json();
                if (data.success) {
                    showAlert(data.message || 'Thao tác thành công.', 'success');
                } else {
                    showAlert(data.message || 'Thao tác thất bại.', 'danger');
                }
                await loadContent(currentUrl, false);
            } catch (err) {
                console.error('Card approval action error', err);
                window.location.reload();
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        });

        // Back / Forward browser navigation
        window.addEventListener('popstate', () => {
            loadContent(window.location.href, false);
        });
    })();
    </script>
}
