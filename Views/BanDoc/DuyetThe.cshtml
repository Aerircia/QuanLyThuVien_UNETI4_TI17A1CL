@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: Trang duyệt yêu cầu đăng ký thẻ bạn đọc cho Thủ thư & Admin - hỗ trợ AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Duyệt thẻ bạn đọc";
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h4 mb-0">Duyệt thẻ bạn đọc</h1>
                <span id="pendingCountBadge" class="badge badge-soft-warning">@Model.Result.TotalCount yêu cầu chờ duyệt</span>
            </div>
            <p class="text-muted small mb-0">Phê duyệt cấp mã số thẻ thư viện hoặc từ chối các yêu cầu mở thẻ mới từ bạn đọc.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                ← Danh sách tất cả bạn đọc
            </a>
        </div>
    </div>

    <partial name="_AlertsPartial" />

    <div id="duyetTheContainer" data-ajax-list data-ajax-badge="#pendingCountBadge" data-ajax-meta="#duyetTheMeta" data-ajax-badge-suffix=" yêu cầu chờ duyệt">
        <partial name="~/Views/BanDoc/_DuyetTheContentPartial.cshtml" model="Model" />
    </div>
</div>
