@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View hiển thị hồ sơ cá nhân, thẻ thư viện và đăng ký thẻ bạn đọc (MyProfile) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocProfileViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    var chuaCoThe = Model.MaBanDoc == 0;
    var choDuyet = !chuaCoThe && Model.TrangThai == TrangThaiBanDoc.ChoDuyet;
    var tuChoi = !chuaCoThe && Model.TrangThai == TrangThaiBanDoc.TuChoi;
    var hoatDong = !chuaCoThe && Model.TrangThai == TrangThaiBanDoc.HoatDong;
    var ngungHoatDong = !chuaCoThe && Model.TrangThai == TrangThaiBanDoc.NgungHoatDong;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Hồ sơ cá nhân &amp; Thẻ thư viện</h1>
            <p class="text-muted mb-0">Quản lý thông tin tài khoản và theo dõi trạng thái thẻ thư viện của bạn.</p>
        </div>
        @if (hoatDong)
        {
            <a asp-action="EditProfile" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Cập nhật thông tin
            </a>
        }
    </div>

    @if (TempData["ThongBao"] is string thongBao)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @thongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] is string loi)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @loi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (choDuyet)
    {
        <!-- TRƯỜNG HỢP 1: ĐANG CHỜ DUYỆT THẺ -->
        <div class="alert alert-success mb-3" role="status">
            <h5 class="alert-heading fw-bold mb-1">Đăng ký thẻ bạn đọc thành công!</h5>
            <div>Hồ sơ đăng ký của bạn đã được gửi thành công và đang chờ đợi thủ thư duyệt thẻ. Bạn sẽ có thể mượn sách ngay sau khi thẻ được phê duyệt.</div>
        </div>

        <div class="alert alert-warning mb-4" role="alert">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h6 class="alert-heading fw-bold mb-1">
                        <span class="badge badge-soft-warning me-2">Chờ duyệt</span> Hồ sơ đang chờ thủ thư xét duyệt cấp thẻ
                    </h6>
                    <div class="small">
                        Hồ sơ đăng ký thẻ thư viện của bạn đã được ghi nhận. Thủ thư hoặc Quản trị viên sẽ kiểm tra thông tin và kích hoạt thẻ chính thức cho bạn trong thời gian sớm nhất.
                    </div>
                </div>
                <div>
                    <form asp-action="HuyDangKyThe" method="post" class="d-inline" id="formHuyDangKyThe">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-confirm-form="#formHuyDangKyThe"
                                data-confirm-title="Hủy yêu cầu cấp thẻ"
                                data-confirm-message="Bạn có chắc chắn muốn hủy yêu cầu đăng ký thẻ bạn đọc này?"
                                data-confirm-ok="Đồng ý hủy"
                                data-confirm-class="btn-danger">

                            Hủy yêu cầu đăng ký
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header fw-bold">Thông tin đăng ký cấp thẻ</div>
                    <div class="card-body">
                        <div class="text-center py-3">
                            <span class="badge badge-soft-warning fs-6 mb-2">ĐANG CHỜ PHÊ DUYỆT</span>
                            <div class="fw-bold fs-5">@Model.HoTen</div>
                            <div class="text-muted small">Đối tượng: @Model.LoaiBanDoc.GetDisplayName()</div>
                        </div>
                        <p class="small text-muted mb-0">
                            Sau khi được phê duyệt, hệ thống sẽ kích hoạt thẻ thư viện và tạo mã thẻ (dạng TV-xxxxxx) để bạn có thể mượn sách.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Chi tiết thông tin đã đăng ký</span>
                        <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm">Chỉnh sửa thông tin</a>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Họ và tên</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

                            <dt class="col-sm-4 text-muted">Tên đăng nhập</dt>
                            <dd class="col-sm-8">@(Model.TenDangNhap ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Ngày sinh</dt>
                            <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Giới tính</dt>
                            <dd class="col-sm-8">@Model.GioiTinh.GetDisplayName()</dd>

                            <dt class="col-sm-4 text-muted">Số điện thoại</dt>
                            <dd class="col-sm-8">@(Model.SoDienThoai ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Email</dt>
                            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Địa chỉ</dt>
                            <dd class="col-sm-8">@(Model.DiaChi ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Loại bạn đọc</dt>
                            <dd class="col-sm-8"><span class="badge badge-soft-info">@Model.LoaiBanDoc.GetDisplayName()</span></dd>

                            <dt class="col-sm-4 text-muted">Trạng thái hồ sơ</dt>
                            <dd class="col-sm-8"><span class="badge badge-soft-warning">@Model.TrangThai.GetDisplayName()</span></dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (chuaCoThe || tuChoi)
    {
        <!-- TRƯỜNG HỢP 2: CHƯA CÓ THẺ HOẶC BỊ TỪ CHỐI -> HIỆN BIỂU MẪU ĐĂNG KÝ -->
        @if (tuChoi)
        {
            <div class="alert alert-danger mb-4" role="alert">
                <h6 class="alert-heading fw-bold mb-1">
                    <span class="badge badge-soft-danger me-2">Từ chối</span> Yêu cầu cấp thẻ bạn đọc đã bị từ chối
                </h6>
                <div class="small">
                    Yêu cầu cấp thẻ bạn đọc của bạn chưa được phê duyệt. Vui lòng kiểm tra lại tính chính xác của các thông tin cá nhân bên dưới và gửi lại yêu cầu để được xét duyệt.
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-4" role="alert">
                <h6 class="alert-heading fw-bold mb-1">Tài khoản chưa có thẻ thư viện</h6>
                <div class="small">
                    Để có thể mượn sách tại Thư viện UNETI, bạn cần đăng ký thẻ bạn đọc. Vui lòng điền đầy đủ các thông tin cần thiết bên dưới để gửi yêu cầu cho Thủ thư xét duyệt.
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">@(tuChoi ? "Gửi lại yêu cầu đăng ký thẻ bạn đọc" : "Đăng ký thẻ bạn đọc mới")</h5>
            </div>
            <div class="card-body">
                <form asp-controller="BanDoc" asp-action="DangKyThe" method="post" id="dangKyTheForm">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input name="HoTen" value="@(Model.DangKyForm?.HoTen ?? Model.HoTen)" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                            <span asp-validation-for="DangKyForm!.HoTen" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email liên hệ <span class="text-danger">*</span></label>
                            <input name="Email" value="@(Model.DangKyForm?.Email ?? Model.Email)" class="form-control" type="email" placeholder="example@gmail.com" required />
                            <span asp-validation-for="DangKyForm!.Email" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Ngày sinh <span class="text-danger">*</span></label>
                            <input name="NgaySinh" value="@(Model.DangKyForm?.NgaySinh != default ? Model.DangKyForm?.NgaySinh.ToString("yyyy-MM-dd") : "2003-01-01")" class="form-control" type="date" required />
                            <span asp-validation-for="DangKyForm!.NgaySinh" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Giới tính</label>
                            <select name="GioiTinh" class="form-select">
                                @foreach (var gt in Enum.GetValues<GioiTinh>())
                                {
                                    <option value="@gt" selected="@(Model.DangKyForm?.GioiTinh == gt)">@gt.GetDisplayName()</option>
                                }
                            </select>
                            <span asp-validation-for="DangKyForm!.GioiTinh" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Đối tượng bạn đọc</label>
                            <select name="LoaiBanDoc" class="form-select">
                                @foreach (var lbd in Enum.GetValues<LoaiBanDoc>())
                                {
                                    <option value="@lbd" selected="@(Model.DangKyForm?.LoaiBanDoc == lbd)">@lbd.GetDisplayName()</option>
                                }
                            </select>
                            <span asp-validation-for="DangKyForm!.LoaiBanDoc" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input name="SoDienThoai" value="@(Model.DangKyForm?.SoDienThoai)" class="form-control" placeholder="09xxxxxxxx (10-11 số)" required />
                            <span asp-validation-for="DangKyForm!.SoDienThoai" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Địa chỉ liên hệ <span class="text-danger">*</span></label>
                            <input name="DiaChi" value="@(Model.DangKyForm?.DiaChi)" class="form-control" placeholder="Số nhà, tên đường, quận/huyện..." required />
                            <span asp-validation-for="DangKyForm!.DiaChi" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-2 border-top d-flex gap-2">
                        <button type="button" class="btn btn-primary"
                                data-confirm-form="#dangKyTheForm"
                                data-confirm-title="Xác nhận đăng ký thẻ bạn đọc"
                                data-confirm-message="Bạn có chắc chắn muốn gửi thông tin đăng ký cấp thẻ thư viện?"
                                data-confirm-ok="Xác nhận gửi"
                                data-confirm-class="btn-primary">
                            <i class="bi bi-card-checklist"></i> Gửi yêu cầu đăng ký thẻ
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Để sau</a>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- TRƯỜNG HỢP 3: ĐÃ CÓ THẺ HOẠT ĐỘNG HOẶC TẠM KHÓA -->
        @if (ngungHoatDong)
        {
            <div class="alert alert-danger mb-4" role="alert">
                <strong>Thẻ thư viện đang bị khóa:</strong> Thẻ của bạn đang tạm thời ngừng hoạt động. Vui lòng liên hệ thủ thư thư viện để biết thêm chi tiết.
            </div>
        }

        <div class="row g-4">
            <!-- Thẻ thư viện trực quan -->
            <div class="col-lg-5">
                <div class="library-card-widget mb-3">
                    <div class="card-sub">THƯ VIỆN ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP</div>
                    <div class="card-code">@(Model.MaSoThe ?? "CHƯA CẤP")</div>
                    <div class="card-name">@Model.HoTen</div>
                    <div class="card-meta d-flex justify-content-between align-items-center">
                        <span>@Model.LoaiBanDoc.GetDisplayName()</span>
                        <span>Hạn thẻ: @Model.NgayHetHanThe.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header fw-bold">Tình trạng mượn sách</div>
                    <div class="card-body">
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block">Đang mượn</small>
                                    <span class="h5 mb-0 fw-bold text-primary">@Model.SoPhieuDangMuon</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block">Quá hạn</small>
                                    <span class="h5 mb-0 fw-bold @(Model.SoPhieuQuaHan > 0 ? "text-danger" : "text-muted")">@Model.SoPhieuQuaHan</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block">Nợ phạt</small>
                                    <span class="h6 mb-0 fw-bold @(Model.TongTienPhatChuaNop > 0 ? "text-danger" : "text-muted")">@Model.TongTienPhatChuaNop.ToString("N0") ₫</span>
                                </div>
                            </div>
                        </div>

                        @if (Model.TheHetHan)
                        {
                            <div class="alert alert-overdue mt-3 mb-0 py-2 small">
                                <strong>Cảnh báo:</strong> Thẻ thư viện của bạn đã hết hạn. Hãy liên hệ thủ thư để được gia hạn thẻ.
                            </div>
                        }

                        <div class="d-grid mt-3">
                            <a asp-controller="PhieuMuon" asp-action="MyLoans" class="btn btn-outline-primary btn-sm">
                                Xem danh sách phiếu mượn của tôi
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chi tiết thông tin cá nhân -->
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Thông tin cá nhân</span>
                        @if (hoatDong)
                        {
                            <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm">Chỉnh sửa</a>
                        }
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Họ và tên</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

                            <dt class="col-sm-4 text-muted">Tên đăng nhập</dt>
                            <dd class="col-sm-8">@(Model.TenDangNhap ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Ngày sinh</dt>
                            <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Giới tính</dt>
                            <dd class="col-sm-8">@Model.GioiTinh.GetDisplayName()</dd>

                            <dt class="col-sm-4 text-muted">Số điện thoại</dt>
                            <dd class="col-sm-8">@(Model.SoDienThoai ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Email</dt>
                            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

                            <dt class="col-sm-4 text-muted">Địa chỉ</dt>
                            <dd class="col-sm-8">@(Model.DiaChi ?? "—")</dd>

                            <hr class="my-3 text-muted" />

                            <dt class="col-sm-4 text-muted">Mã số thẻ</dt>
                            <dd class="col-sm-8"><span class="badge badge-soft-primary font-monospace">@(Model.MaSoThe ?? "Chưa cấp")</span></dd>

                            <dt class="col-sm-4 text-muted">Loại bạn đọc</dt>
                            <dd class="col-sm-8">@Model.LoaiBanDoc.GetDisplayName()</dd>

                            <dt class="col-sm-4 text-muted">Ngày cấp thẻ</dt>
                            <dd class="col-sm-8">@Model.NgayCapThe.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Ngày hết hạn thẻ</dt>
                            <dd class="col-sm-8">
                                @Model.NgayHetHanThe.ToString("dd/MM/yyyy")
                                @if (Model.TheHetHan)
                                {
                                    <span class="badge badge-soft-danger ms-2">Đã hết hạn</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted">Trạng thái thẻ</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.TrangThai switch {
                                    TrangThaiBanDoc.HoatDong => "badge-soft-success",
                                    TrangThaiBanDoc.ChoDuyet => "badge-soft-warning",
                                    TrangThaiBanDoc.TuChoi => "badge-soft-danger",
                                    TrangThaiBanDoc.NgungHoatDong => "badge-soft-danger",
                                    _ => "badge-soft-secondary"
                                })">
                                    @Model.TrangThai.GetDisplayName()
                                </span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
