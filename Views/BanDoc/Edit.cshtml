@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View chỉnh sửa thông tin bạn đọc (Thủ thư & Admin); hồ sơ chờ duyệt / bị từ chối chỉ đổi trạng thái ở trang Duyệt thẻ *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocEditViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Chỉnh sửa bạn đọc";
    var issued = Model.TrangThai is TrangThaiBanDoc.HoatDong or TrangThaiBanDoc.NgungHoatDong;
    var statusItems = Html.GetEnumSelectList<TrangThaiBanDoc>()
        .Where(i => i.Value == ((int)TrangThaiBanDoc.HoatDong).ToString() || i.Value == ((int)TrangThaiBanDoc.NgungHoatDong).ToString())
        .ToList();
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h4 mb-0">Chỉnh sửa hồ sơ bạn đọc: @Model.HoTen</h1>
                    <span class="small text-muted font-monospace">Mã bạn đọc #@Model.MaBanDoc · Tài khoản: @Model.TenDangNhap</span>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại danh sách</a>
            </div>

            <div class="app-card">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="MaBanDoc" />
                    <input type="hidden" asp-for="MaTaiKhoan" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h5 class="h6 text-muted mb-3 text-uppercase">1. Thông tin cá nhân</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="NgaySinh" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="NgaySinh" type="date" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="GioiTinh" class="form-label fw-semibold"></label>
                            <select asp-for="GioiTinh" class="form-select" asp-items="Html.GetEnumSelectList<GioiTinh>()"></select>
                            <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="SoDienThoai" class="form-control" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="h6 text-muted mb-3 text-uppercase">2. Thông tin thẻ thư viện</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MaSoThe" class="form-label fw-semibold"></label>
                            <input asp-for="MaSoThe" class="form-control font-monospace" />
                            <span asp-validation-for="MaSoThe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LoaiBanDoc" class="form-label fw-semibold"></label>
                            <select asp-for="LoaiBanDoc" class="form-select" asp-items="Html.GetEnumSelectList<LoaiBanDoc>()"></select>
                            <span asp-validation-for="LoaiBanDoc" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NgayCapThe" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="NgayCapThe" type="date" class="form-control" />
                            <span asp-validation-for="NgayCapThe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NgayHetHanThe" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="NgayHetHanThe" type="date" class="form-control" />
                            <span asp-validation-for="NgayHetHanThe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                            @if (issued)
                            {
                                <select asp-for="TrangThai" class="form-select" asp-items="statusItems"></select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="TrangThai" />
                                <input class="form-control" value="@Model.TrangThai.GetDisplayName()" readonly />
                                <div class="form-text">Hồ sơ chờ duyệt hoặc bị từ chối được xử lý ở trang Duyệt thẻ.</div>
                            }
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
