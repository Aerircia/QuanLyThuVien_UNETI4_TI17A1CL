@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View quản lý danh sách bạn đọc và duyệt cấp thẻ (Thủ thư & Admin) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Quản lý bạn đọc";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var loaiItems = Html.GetEnumSelectList<LoaiBanDoc>().ToList();
    foreach (var item in loaiItems)
        item.Selected = Model.LoaiBanDoc is { } l && item.Value == ((int)l).ToString();

    var trangThaiItems = Html.GetEnumSelectList<TrangThaiBanDoc>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } t && item.Value == ((int)t).ToString();
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Quản lý bạn đọc &amp; Thẻ thư viện</h1>
            <p class="text-muted small mb-0">Xử lý yêu cầu đăng ký thẻ bạn đọc mới, danh sách thẻ và trạng thái hoạt động.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="DuyetThe" class="btn btn-warning">
                Duyệt thẻ bạn đọc (@Model.SoBanDocChoDuyet)
            </a>
            <a asp-action="Create" class="btn btn-primary">
                + Thêm bạn đọc
            </a>
        </div>
    </div>

    <partial name="_AlertsPartial" />

    <!-- Quick filter tabs: click chuyển tab qua AJAX, không tải lại trang -->
    <div class="d-flex flex-wrap gap-2 mb-3" id="tab-loc-ban-doc">
        <a asp-action="Index" data-ajax-list-target="#vung-ket-qua-ban-doc" data-ajax-clear-form="#bo-loc-ban-doc" class="btn btn-sm quick-tab-ban-doc @(!Model.TrangThai.HasValue ? "btn-primary" : "btn-light border")" data-active-class="btn-primary" data-gia-tri="">
            Tất cả (@Model.TongSoBanDoc)
        </a>
        <a asp-action="Index" asp-route-trangThai="@(nameof(TrangThaiBanDoc.ChoDuyet))" data-ajax-list-target="#vung-ket-qua-ban-doc" data-ajax-clear-form="#bo-loc-ban-doc" class="btn btn-sm quick-tab-ban-doc @(Model.TrangThai == TrangThaiBanDoc.ChoDuyet ? "btn-warning" : "btn-light border")" data-active-class="btn-warning" data-gia-tri="@((int)TrangThaiBanDoc.ChoDuyet)">
            Chờ duyệt cấp thẻ (@Model.SoBanDocChoDuyet)
        </a>
        <a asp-action="Index" asp-route-trangThai="@(nameof(TrangThaiBanDoc.HoatDong))" data-ajax-list-target="#vung-ket-qua-ban-doc" data-ajax-clear-form="#bo-loc-ban-doc" class="btn btn-sm quick-tab-ban-doc @(Model.TrangThai == TrangThaiBanDoc.HoatDong ? "btn-primary" : "btn-light border")" data-active-class="btn-primary" data-gia-tri="@((int)TrangThaiBanDoc.HoatDong)">
            Đang hoạt động (@Model.SoBanDocHoatDong)
        </a>
        <a asp-action="Index" asp-route-trangThai="@(nameof(TrangThaiBanDoc.NgungHoatDong))" data-ajax-list-target="#vung-ket-qua-ban-doc" data-ajax-clear-form="#bo-loc-ban-doc" class="btn btn-sm quick-tab-ban-doc @(Model.TrangThai == TrangThaiBanDoc.NgungHoatDong ? "btn-primary" : "btn-light border")" data-active-class="btn-primary" data-gia-tri="@((int)TrangThaiBanDoc.NgungHoatDong)">
            Ngừng hoạt động / Khóa (@Model.SoBanDocNgungHoatDong)
        </a>
        <a asp-action="Index" asp-route-trangThai="@(nameof(TrangThaiBanDoc.TuChoi))" data-ajax-list-target="#vung-ket-qua-ban-doc" data-ajax-clear-form="#bo-loc-ban-doc" class="btn btn-sm quick-tab-ban-doc @(Model.TrangThai == TrangThaiBanDoc.TuChoi ? "btn-danger" : "btn-light border")" data-active-class="btn-danger" data-gia-tri="@((int)TrangThaiBanDoc.TuChoi)">
            Từ chối (@Model.SoBanDocTuChoi)
        </a>
    </div>

    <!-- Bộ lọc tìm kiếm -->
    <div class="card mb-3">
        <div class="card-body">
            <form id="bo-loc-ban-doc" method="get" asp-action="Index" class="row g-2 align-items-center" data-ajax-filter-form>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-md-5">
                    <input name="search" value="@Model.Search" class="form-control" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350"
                           placeholder="Tìm theo tên bạn đọc, mã thẻ, số điện thoại, email..." />
                </div>
                <div class="col-md-3">
                    <select name="loaiBanDoc" class="form-select" asp-items="loaiItems">
                        <option value="">Tất cả loại bạn đọc</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="trangThai" class="form-select" asp-items="trangThaiItems">
                        <option value="">Tất cả trạng thái</option>
                    </select>
                </div>
                <div class="col-md-1 d-grid">
                    <a asp-action="Index" data-ajax-clear class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    @* Vùng kết quả: lọc/tìm kiếm/phân trang qua AJAX - JS tải cả trang rồi cắt vùng này thay vào *@
    <div id="vung-ket-qua-ban-doc" data-ajax-list data-ajax-form="#bo-loc-ban-doc" data-ajax-document-selector="#vung-ket-qua-ban-doc" data-ajax-tabs="#tab-loc-ban-doc" data-ajax-change>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Bạn đọc</th>
                    <th>Mã số thẻ</th>
                    <th>Loại bạn đọc</th>
                    <th>Hạn thẻ</th>
                    <th class="text-center">Đang mượn</th>
                    <th class="text-center">Quá hạn</th>
                    <th class="text-end">Nợ phạt</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Result.Items)
                {
                    var isChoDuyet = item.TrangThai == TrangThaiBanDoc.ChoDuyet;
                    var isIssued = item.TrangThai is TrangThaiBanDoc.HoatDong or TrangThaiBanDoc.NgungHoatDong;
                    var locked = item.TrangThai == TrangThaiBanDoc.NgungHoatDong;
                    <tr class="@(isChoDuyet ? "table-warning" : "")">
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaBanDoc" class="fw-bold text-decoration-none text-dark">
                                @item.HoTen
                            </a>
                            <div class="small text-muted">@item.SoDienThoai · @item.Email</div>
                        </td>
                        <td>
                            <span class="badge badge-soft-primary font-monospace">@(item.MaSoThe ?? "Chưa cấp")</span>
                        </td>
                        <td>@item.LoaiBanDoc.GetDisplayName()</td>
                        <td>
                            @if (!isIssued)
                            {
                                <span class="text-muted small">@(isChoDuyet ? "Chờ duyệt" : "—")</span>
                            }
                            else
                            {
                                <span class="@(item.TheHetHan ? "text-danger fw-bold" : "")">
                                    @item.NgayHetHanThe.ToString("dd/MM/yyyy")
                                </span>
                                @if (item.TheHetHan)
                                {
                                    <span class="badge badge-soft-danger small ms-1">Hết hạn</span>
                                }
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(item.SoPhieuDangMuon > 0 ? "badge-soft-primary" : "badge-soft-secondary")">
                                @item.SoPhieuDangMuon
                            </span>
                        </td>
                        <td class="text-center">
                            @if (item.SoPhieuQuaHan > 0)
                            {
                                <span class="badge badge-soft-danger">@item.SoPhieuQuaHan</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.TongTienPhatChuaNop > 0)
                            {
                                <span class="text-danger fw-bold">@item.TongTienPhatChuaNop.ToString("N0") ₫</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(item.TrangThai switch {
                                TrangThaiBanDoc.HoatDong => "badge-soft-success",
                                TrangThaiBanDoc.ChoDuyet => "badge-soft-warning",
                                TrangThaiBanDoc.TuChoi => "badge-soft-danger",
                                TrangThaiBanDoc.NgungHoatDong => "badge-soft-danger",
                                _ => "badge-soft-secondary"
                            })">
                                @item.TrangThai.GetDisplayName()
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaBanDoc" class="btn btn-sm btn-outline-primary">Chi tiết</a>
    
                            @if (isChoDuyet)
                            {
                                <form asp-action="Duyet" method="post" class="d-inline" id="duyetTheIndexForm-@item.MaBanDoc">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-confirm-form="#duyetTheIndexForm-@item.MaBanDoc"
                                            data-confirm-title="Duyệt cấp thẻ bạn đọc"
                                            data-confirm-message="Duyệt cấp thẻ thư viện cho bạn đọc @item.HoTen?"
                                            data-confirm-ok="Duyệt cấp thẻ"
                                            data-confirm-class="btn-primary">
    
                                        Duyệt
                                    </button>
                                </form>
                                <form asp-action="TuChoi" method="post" class="d-inline" id="tuChoiTheIndexForm-@item.MaBanDoc">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-confirm-form="#tuChoiTheIndexForm-@item.MaBanDoc"
                                            data-confirm-title="Từ chối cấp thẻ bạn đọc"
                                            data-confirm-message="Từ chối yêu cầu cấp thẻ của bạn đọc @item.HoTen?"
                                            data-confirm-ok="Từ chối"
                                            data-confirm-class="btn-danger">
    
                                        Từ chối
                                    </button>
                                </form>
                            }
                            else if (isIssued)
                            {
                                <a asp-action="Edit" asp-route-id="@item.MaBanDoc" class="btn btn-sm btn-outline-secondary">Sửa</a>
                                <form asp-action="SetStatus" method="post" class="d-inline" id="statusBanDocIndex-@item.MaBanDoc">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="trangThai" value="@(locked ? nameof(TrangThaiBanDoc.HoatDong) : nameof(TrangThaiBanDoc.NgungHoatDong))" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="button" class="btn btn-sm @(locked ? "btn-outline-primary" : "btn-outline-danger")"
                                            data-confirm-form="#statusBanDocIndex-@item.MaBanDoc"
                                            data-confirm-title="@(locked ? "Mở khóa bạn đọc" : "Tạm khóa bạn đọc")"
                                            data-confirm-message="@(locked ? $"Bạn có chắc muốn kích hoạt lại bạn đọc {item.HoTen}?" : $"Bạn có chắc muốn tạm khóa bạn đọc {item.HoTen}?")"
                                            data-confirm-ok="@(locked ? "Mở khóa" : "Tạm khóa")"
                                            data-confirm-class="@(locked ? "btn-primary" : "btn-danger")">
    
                                        @(locked ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
    
                @if (!Model.Result.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không tìm thấy bạn đọc nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="phan-trang mt-3">
        <partial name="_PagerPartial" model="Model.Pager" />
    </div>
    </div>
</div>
