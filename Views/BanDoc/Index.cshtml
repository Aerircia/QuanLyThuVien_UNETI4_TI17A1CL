@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View quản lý danh sách bạn đọc (Thủ thư & Admin) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Quản lý bạn đọc";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var loaiItems = Html.GetEnumSelectList<LoaiBanDoc>().ToList();
    foreach (var item in loaiItems)
        item.Selected = Model.LoaiBanDoc is { } l && item.Value == ((int)l).ToString();

    var trangThaiItems = Html.GetEnumSelectList<TrangThaiBanDoc>().ToList();
    foreach (var item in trangThaiItems)
        item.Selected = Model.TrangThai is { } t && item.Value == ((int)t).ToString();
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Quản lý bạn đọc</h1>
            <p class="text-muted small mb-0">Danh sách tài khoản bạn đọc, mã thẻ thư viện và trạng thái hoạt động.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> + Thêm bạn đọc
        </a>
    </div>

    @if (TempData["ThongBao"] is string thongBao)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @thongBao
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] is string loi)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @loi
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc tìm kiếm -->
    <div class="app-card mb-3 p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-md-5">
                <input name="search" value="@Model.Search" class="form-control"
                       placeholder="Tìm theo tên bạn đọc, mã thẻ, số điện thoại, email..." />
            </div>
            <div class="col-md-3">
                <select name="loaiBanDoc" class="form-select" asp-items="loaiItems">
                    <option value="">Tất cả loại bạn đọc</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="trangThai" class="form-select" asp-items="trangThaiItems">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-outline-primary">Lọc</button>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách -->
    <div class="app-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Bạn đọc</th>
                        <th>Mã số thẻ</th>
                        <th>Loại bạn đọc</th>
                        <th>Hạn thẻ</th>
                        <th class="text-center">Đang mượn</th>
                        <th class="text-center">Quá hạn</th>
                        <th class="text-end">Nợ phạt</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Result.Items)
                    {
                        var locked = item.TrangThai == TrangThaiBanDoc.NgungHoatDong;
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaBanDoc" class="fw-bold text-decoration-none text-dark">
                                    @item.HoTen
                                </a>
                                <div class="small text-muted">@item.SoDienThoai · @item.Email</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@(item.MaSoThe ?? "Chưa cấp")</span>
                            </td>
                            <td>@item.LoaiBanDoc.GetDisplayName()</td>
                            <td>
                                <span class="@(item.TheHetHan ? "text-danger fw-bold" : "")">
                                    @item.NgayHetHanThe.ToString("dd/MM/yyyy")
                                </span>
                                @if (item.TheHetHan)
                                {
                                    <span class="badge bg-danger small ms-1">Hết hạn</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.SoPhieuDangMuon > 0 ? "bg-primary" : "bg-light text-muted")">
                                    @item.SoPhieuDangMuon
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.SoPhieuQuaHan > 0)
                                {
                                    <span class="badge bg-danger">@item.SoPhieuQuaHan</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.TongTienPhatChuaNop > 0)
                                {
                                    <span class="text-danger fw-bold">@item.TongTienPhatChuaNop.ToString("N0") ₫</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(locked ? "bg-danger" : "bg-success")">
                                    @item.TrangThai.GetDisplayName()
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.MaBanDoc" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.MaBanDoc" class="btn btn-sm btn-outline-secondary">Sửa</a>
                                <form asp-action="SetStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="trangThai" value="@(locked ? nameof(TrangThaiBanDoc.HoatDong) : nameof(TrangThaiBanDoc.NgungHoatDong))" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm @(locked ? "btn-outline-success" : "btn-outline-warning")"
                                            onclick="return confirm('Bạn có chắc muốn @(locked ? "kích hoạt lại" : "tạm khóa") bạn đọc này?');">
                                        @(locked ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                    @if (!Model.Result.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Không tìm thấy bạn đọc nào phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <partial name="_PagerPartial" model="Model.Pager" />
    </div>
</div>
