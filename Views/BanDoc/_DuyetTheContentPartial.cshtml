@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: Partial nội dung duyệt thẻ bạn đọc hỗ trợ AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.BanDocListViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div id="duyetTheAlertContainer"></div>

<!-- Data attribute để cập nhật badge số lượng ngoài header -->
<div id="duyetTheMeta" data-total-count="@Model.Result.TotalCount" style="display:none;"></div>

<!-- Search bar -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="DuyetThe" id="duyetTheSearchForm" class="row g-2 align-items-center" data-ajax-filter-form>
            <div class="col-md-9 col-lg-10">
                <input name="search" value="@Model.Search" class="form-control form-control-sm" data-ajax-search data-ajax-search-min="2" data-ajax-search-delay="350"
                       placeholder="Tìm kiếm theo họ tên, tên đăng nhập, số điện thoại, email..." />
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <a asp-action="DuyetThe" data-ajax-clear class="btn btn-outline-secondary btn-sm duyet-the-link">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Result.Items.Any())
{
    <div class="alert alert-info py-4 text-center my-4" role="status">
        <h5 class="fw-bold mb-1">Hiện không có yêu cầu đăng ký thẻ nào đang chờ duyệt</h5>
        <p class="text-muted mb-0">Khi bạn đọc gửi yêu cầu mở thẻ mới, thông tin sẽ được cập nhật và hiển thị tại đây để bạn phê duyệt.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Họ và tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Thông tin cá nhân</th>
                    <th>Liên hệ &amp; Địa chỉ</th>
                    <th>Đối tượng</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="min-width: 220px;">Hành động duyệt</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var stt = (Model.Result.Page - 1) * Model.Result.PageSize;
                }
                @foreach (var item in Model.Result.Items)
                {
                    stt++;
                    <tr>
                        <td class="text-muted">@stt</td>
                        <td>
                            <div class="fw-bold">@item.HoTen</div>
                            <small class="text-muted">Mã bạn đọc: #@item.MaBanDoc</small>
                        </td>
                        <td>
                            <code>@(item.TenDangNhap ?? "Chưa liên kết")</code>
                        </td>
                        <td>
                            <div>@item.NgaySinh.ToString("dd/MM/yyyy")</div>
                            <small class="text-muted">Giới tính: @item.GioiTinh.GetDisplayName()</small>
                        </td>
                        <td>
                            <div><i class="bi bi-telephone"></i> @(item.SoDienThoai ?? "Chưa có SĐT")</div>
                            <div class="small text-muted"><i class="bi bi-envelope"></i> @(item.Email ?? "Chưa có email")</div>
                            @if (!string.IsNullOrWhiteSpace(item.DiaChi))
                            {
                                <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.DiaChi">
                                    <i class="bi bi-geo-alt"></i> @item.DiaChi
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-soft-info">@item.LoaiBanDoc.GetDisplayName()</span>
                        </td>
                        <td>
                            <span class="badge badge-soft-warning">@item.TrangThai.GetDisplayName()</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <form asp-action="Duyet" method="post" class="d-inline card-approval-form" id="duyetTheForm-@item.MaBanDoc" data-ajax-action="json" data-ajax-refresh="#duyetTheContainer" data-ajax-alert="#duyetTheAlertContainer" data-ajax-badge="#pendingCountBadge" data-ajax-badge-suffix=" yêu cầu chờ duyệt">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="button" class="btn btn-primary btn-sm"
                                            data-confirm-form="#duyetTheForm-@item.MaBanDoc"
                                            data-confirm-title="Duyệt cấp thẻ bạn đọc"
                                            data-confirm-message="Xác nhận phê duyệt và cấp mã số thẻ thư viện cho bạn đọc @item.HoTen?"
                                            data-confirm-ok="Duyệt cấp thẻ"
                                            data-confirm-class="btn-primary">
                                        Duyệt cấp thẻ
                                    </button>
                                </form>

                                <form asp-action="TuChoi" method="post" class="d-inline card-approval-form" id="tuChoiTheForm-@item.MaBanDoc" data-ajax-action="json" data-ajax-refresh="#duyetTheContainer" data-ajax-alert="#duyetTheAlertContainer" data-ajax-badge="#pendingCountBadge" data-ajax-badge-suffix=" yêu cầu chờ duyệt">
                                    <input type="hidden" name="id" value="@item.MaBanDoc" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-confirm-form="#tuChoiTheForm-@item.MaBanDoc"
                                            data-confirm-title="Từ chối cấp thẻ bạn đọc"
                                            data-confirm-message="Bạn có chắc muốn từ chối yêu cầu cấp thẻ của @item.HoTen?"
                                            data-confirm-ok="Từ chối"
                                            data-confirm-class="btn-danger">
                                        Từ chối
                                    </button>
                                </form>

                                <a asp-action="Details" asp-route-id="@item.MaBanDoc" class="btn btn-outline-secondary btn-sm" title="Xem chi tiết hồ sơ">
                                    Chi tiết
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <partial name="_PagerPartial" model="Model.Pager" />
    </div>
}

