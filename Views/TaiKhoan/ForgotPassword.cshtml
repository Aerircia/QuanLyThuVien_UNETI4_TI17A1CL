@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế view quên mật khẩu *@
@* Giao diện quên mật khẩu bước 1 (nhập email). Liên kết "Tôi đã có mã OTP" chỉ hiện khi còn phiên đặt lại (ViewBag.PendingEmail). *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    var hasPending = !string.IsNullOrEmpty(ViewBag.PendingEmail as string);
}

@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="app-card auth-card">
        <partial name="_ResetSteps" model="1" />

        <div class="auth-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </div>
        <h1 class="auth-title">Quên mật khẩu?</h1>
        <p class="auth-sub">Nhập email của tài khoản, chúng tôi sẽ gửi mã OTP gồm 6 chữ số để bạn đặt lại mật khẩu.</p>

                <partial name="_AlertsPartial" />

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Gửi mã OTP</button>
        </form>

        <p class="auth-foot">
            @if (hasPending)
            {
                <a asp-action="VerifyOtp">Tôi đã có mã OTP</a>
                <text>&middot;</text>
            }
            <a asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forms.js" asp-append-version="true"></script>
}
