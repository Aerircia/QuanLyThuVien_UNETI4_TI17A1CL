@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế view quên mật khẩu *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h4 mb-3">Quên mật khẩu</h1>
        <p class="text-muted">Nhập email của tài khoản, chúng tôi sẽ gửi mã OTP để bạn đặt lại mật khẩu.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Gửi mã OTP</button>
        </form>

        <p class="mt-3 text-center">
            <a asp-action="ResetPassword" asp-route-email="@Model.Email">Tôi đã có mã OTP</a>
            &middot;
            <a asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
