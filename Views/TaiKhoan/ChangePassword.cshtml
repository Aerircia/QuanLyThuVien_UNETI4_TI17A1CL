@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng trang đổi mật khẩu *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="page-head">
            <div>
                <h1>Đổi mật khẩu</h1>
                <p class="text-muted mb-0">Nhập mật khẩu hiện tại và chọn mật khẩu mới.</p>
            </div>
        </div>

        @if (TempData["ThongBao"] is string thongBao)
        {
            <div class="alert alert-success" role="status">@thongBao</div>
        }

        <div class="app-card account-form">
            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="MatKhauCu" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="MatKhauCu" class="form-control" autocomplete="current-password" autofocus />
                        <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#MatKhauCu" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                    </div>
                    <span asp-validation-for="MatKhauCu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#MatKhauMoi" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                    </div>
                    <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                    <div class="form-text">Ít nhất 6 ký tự.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="XacNhanMatKhauMoi" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="XacNhanMatKhauMoi" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#XacNhanMatKhauMoi" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                    </div>
                    <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Lưu mật khẩu mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forms.js" asp-append-version="true"></script>
}