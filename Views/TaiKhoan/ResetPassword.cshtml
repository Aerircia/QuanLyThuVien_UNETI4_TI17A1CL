@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế view đặt lại mật khẩu *@
@*  Giao diện quên mật khẩu bước 3 (đặt mật khẩu mới) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="app-card auth-card">
        <partial name="_ResetSteps" model="3" />

        <div class="auth-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="M10.8 12.2 20 3M16 7l3 3M14 9l2 2" /></svg>
        </div>
        <h1 class="auth-title">Đặt mật khẩu mới</h1>
        <p class="auth-sub">Tài khoản: <strong>@Model.Email</strong></p>

        <form asp-action="ResetPassword" method="post" novalidate>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="MaOtp" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <span asp-validation-for="MaOtp" class="text-danger"></span>

            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" autofocus />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#MatKhauMoi" aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                <div class="form-text">Ít nhất 6 ký tự.</div>
            </div>

            <div class="mb-3">
                <label asp-for="XacNhanMatKhauMoi" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="XacNhanMatKhauMoi" class="form-control" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#XacNhanMatKhauMoi" aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Lưu mật khẩu mới</button>
        </form>

        <p class="auth-foot"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forms.js" asp-append-version="true"></script>
}
