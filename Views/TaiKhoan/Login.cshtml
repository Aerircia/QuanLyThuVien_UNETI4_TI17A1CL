@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng trang đăng nhập *@
@* Giao diện đăng nhập (tên đăng nhập hoặc email, hiện/ẩn mật khẩu) *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="app-card auth-card">
        <div class="auth-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
        </div>
        <h1 class="auth-title">Chào mừng quay lại</h1>
        <p class="auth-sub">Đăng nhập bằng tên đăng nhập hoặc email.</p>

                <partial name="_AlertsPartial" />
        @if (ViewBag.ThongBao is string thongBao)
        {
            <div class="alert alert-warning" role="alert">@thongBao</div>
        }

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="MatKhau" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary pw-toggle" data-toggle-password="#MatKhau" aria-label="Hiện mật khẩu" aria-pressed="false"><partial name="_Icon" model='"eye"' /><partial name="_Icon" model='"eye-off"' /></button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <div class="text-end mb-3">
                <a asp-action="ForgotPassword" class="small fw-semibold">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
        </form>

        <p class="auth-foot">Chưa có tài khoản? <a asp-action="Register" class="fw-semibold">Đăng ký</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forms.js" asp-append-version="true"></script>
}
