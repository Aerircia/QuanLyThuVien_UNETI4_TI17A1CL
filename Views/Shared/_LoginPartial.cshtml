@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng phần đăng nhập/đăng xuất *@
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@inject ICurrentUserService Current

@* Chỉ để hiển thị. Quyền thật sự được kiểm tra ở Controller bằng [AuthorizeRole]. *@
<ul class="navbar-nav ms-auto align-items-lg-center">
    @if (Current.User is { } user)
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="TaiKhoan" asp-action="ChangePassword">
                @user.HoTen (@user.VaiTro.GetDisplayName())
            </a>
        </li>
        <li class="nav-item">
            <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="TaiKhoan" asp-action="Login">Đăng nhập</a>
        </li>
    }
</ul>
