@* Họ và tên: Phùng Ngọc Bảo *@
@* Mã sinh viên: 23103100278 *@
@* Nội dung thực hiện: Chuông thông báo và danh sách thông báo gần đây trên header *@
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Common
@inject ICurrentUserService Current
@inject IThongBaoService ThongBaoService
@{
    var user = Current.User;
    var bell = user is null ? null : await ThongBaoService.GetBellAsync(user.MaTaiKhoan, 8, Context.RequestAborted);
    var unread = bell?.ChuaDoc ?? 0;
    var notificationReturnUrl = Url.Action("Index", "ThongBao");
    var notificationReturnText = "Xem tất cả thông báo";
}
@if (user is not null)
{
    <form id="notificationTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
    <div class="dropdown app-notification" data-notification-widget
         data-bell-url="@Url.Action("Bell", "ThongBao")"
         data-read-url="@Url.Action("MarkRead", "ThongBao")"
         data-read-all-url="@Url.Action("MarkAllRead", "ThongBao")">
        <button class="app-header-icon-button app-notification-trigger" type="button"
                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-controls="notificationMenu"
                aria-label="Thông báo" title="Thông báo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
            <span class="app-notification-count" data-notification-count aria-live="polite" aria-atomic="true" hidden="@(unread == 0)">@(unread > 9 ? "9+" : unread)</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end app-notification-menu" id="notificationMenu">
            <div class="app-notification-heading">
                <div><strong>Thông báo</strong><small>Cập nhật hoạt động thư viện</small></div>
                <button type="button" class="btn btn-sm btn-light" data-notification-read-all @(unread == 0 ? "disabled" : null)>Đọc tất cả</button>
            </div>
            <div class="app-notification-list" data-notification-list aria-live="polite">
                @if (bell is not null && bell.DanhSach.Count > 0)
                {
                    foreach (var item in bell.DanhSach)
                    {
                        var link = Url.Action("Open", "ThongBao", new { id = item.MaThongBao })!;
                        <a class="app-notification-item @(item.DaDoc ? "" : "is-unread")" href="@link"
                           data-notification-item data-notification-id="@item.MaThongBao">
                            <span class="app-notification-icon @(item.LoaiThongBao == "fine" ? "is-fine" : "")">
                                @if (item.LoaiThongBao == "fine")
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h10M7 13h5"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
                                }
                            </span>
                            <span class="app-notification-copy"><strong>@item.TieuDe</strong><span>@item.NoiDung</span><small>@LibraryClock.ToVietnamTime(item.NgayTao).ToString("HH:mm · dd/MM/yyyy")</small></span>
                            @if (!item.DaDoc) { <i class="app-notification-dot" aria-label="Chưa đọc"></i> }
                        </a>
                    }
                }
                else
                {
                    <div class="app-notification-empty" data-notification-empty>
                        <span aria-hidden="true">✓</span><strong>Bạn đã cập nhật!</strong><small>Chưa có thông báo mới.</small>
                    </div>
                }
            </div>
            <a class="app-notification-footer" href="@notificationReturnUrl">@notificationReturnText <span aria-hidden="true">→</span></a>
        </div>
    </div>
}
