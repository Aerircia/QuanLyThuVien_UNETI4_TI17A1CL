@* Bố cục 2 cột: thông tin giao dịch (trái) + các khoản phạt (phải). Dùng cho ThanhToan/ChiTiet và QuanLyLichSuThanhToan/Details. *@
@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.GiaoDichDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
<div class="row g-3 pay-layout">
    <div class="col-lg-5">
        <div class="card pay-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Giao dịch #@Model.MaGiaoDich</span>
                <span class="badge @ThanhToanUi.BadgeClass(Model.TrangThai)">@Model.TrangThai.GetDisplayName()</span>
            </div>
            <div class="card-body"><partial name="_GiaoDichInfo" model="Model" /></div>
        </div>
    </div>
    <div class="col-lg-7"><partial name="_GiaoDichKhoanPhat" model="Model" /></div>
</div>
