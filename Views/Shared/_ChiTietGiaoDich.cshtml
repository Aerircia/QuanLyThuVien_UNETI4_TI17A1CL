@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng chi tiết giao dịch *@
@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.GiaoDichDetail
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Giao dịch #@Model.MaGiaoDich</span>
        <span class="badge @ThanhToanUi.BadgeClass(Model.TrangThai)">@Model.TrangThai.GetDisplayName()</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6"><small class="text-muted d-block">Bạn đọc</small><strong>@Model.HoTen</strong> <span class="font-monospace text-muted">@Model.MaSoThe</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">Hình thức</small>@Model.PhuongThuc.GetDisplayName()</div>
            <div class="col-sm-6"><small class="text-muted d-block">Tổng tiền</small><strong class="fs-5">@Model.TongTien.ToString("N0") ₫</strong></div>
            <div class="col-sm-6"><small class="text-muted d-block">Ngày tạo</small>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
            @if (Model.OrderCode.HasValue)
            {
                <div class="col-sm-6"><small class="text-muted d-block">Mã đơn payOS</small><span class="font-monospace">@Model.OrderCode</span></div>
            }
            @if (Model.NgayHetHan.HasValue && Model.TrangThai == TrangThaiGiaoDich.ChoThanhToan)
            {
                <div class="col-sm-6"><small class="text-muted d-block">Hết hạn lúc</small>@Model.NgayHetHan.Value.ToString("dd/MM/yyyy HH:mm")</div>
            }
            <div class="col-sm-6"><small class="text-muted d-block">Ngày thanh toán</small>@(Model.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
            @if (!string.IsNullOrEmpty(Model.NguoiXacNhan))
            {
                <div class="col-sm-6"><small class="text-muted d-block">Người xác nhận</small>@Model.NguoiXacNhan</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <div class="col-12"><div class="alert alert-warning mb-0">@Model.GhiChu</div></div>
            }
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">Các khoản phạt trong giao dịch (@Model.Lines.Count)</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Phiếu mượn</th><th>Sách</th><th class="text-end">Số tiền</th></tr></thead>
            <tbody>
            @foreach (var l in Model.Lines)
            {
                <tr><td>#@l.MaPhieuMuon</td><td>@l.TenSach</td><td class="text-end">@l.SoTien.ToString("N0") ₫</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
