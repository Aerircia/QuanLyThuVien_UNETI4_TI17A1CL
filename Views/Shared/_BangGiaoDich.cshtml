@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Xây dựng bảng lịch sử thanh toán *@
@* Bảng lịch sử thanh toán dùng chung. ViewData["Ctl"]/["Act"] = trang chi tiết; ViewData["ShowReader"] = hiện cột bạn đọc *@
@model QuanLyThuVien_UNETI4_TI17A1CL.Services.Common.PagedResult<QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces.GiaoDichListItem>
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.ViewModels
@{
    var ctl = ViewData["Ctl"] as string ?? "ThanhToan";
    var act = ViewData["Act"] as string ?? "ChiTiet";
    var showReader = ViewData["ShowReader"] is true;
}
<div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Mã GD</th>
                <th>Ngày tạo</th>
                @if (showReader) { <th>Bạn đọc</th> }
                <th>Hình thức</th>
                <th class="text-end">Số khoản</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Ngày thanh toán</th>
                @if (showReader) { <th>Người xác nhận</th> }
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var g in Model.Items)
        {
            <tr>
                <td>#@g.MaGiaoDich
                    @if (g.OrderCode.HasValue) { <div class="small text-muted font-monospace">@g.OrderCode</div> }
                </td>
                <td>@g.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                @if (showReader)
                {
                    <td><div class="fw-semibold">@g.HoTen</div><small class="text-muted font-monospace">@(g.MaSoThe ?? "—")</small></td>
                }
                <td>@g.PhuongThuc.GetDisplayName()</td>
                <td class="text-end">@g.SoKhoan</td>
                <td class="text-end fw-semibold">@g.TongTien.ToString("N0") ₫</td>
                <td><span class="badge @ThanhToanUi.BadgeClass(g.TrangThai)">@g.TrangThai.GetDisplayName()</span></td>
                <td>@(g.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                @if (showReader) { <td>@(g.NguoiXacNhan ?? "—")</td> }
                <td class="text-end"><a asp-controller="@ctl" asp-action="@act" asp-route-id="@g.MaGiaoDich" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="10" class="text-center text-muted py-4">Chưa có giao dịch nào.</td></tr>
        }
        </tbody>
    </table>
</div>
<div class="mt-3"><partial name="_PagerPartial" model="(PagerViewModel)ViewBag.Pager" /></div>
