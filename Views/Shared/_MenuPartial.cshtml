@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế menu phân quyền *@

@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: thêm liên kết menu yêu cầu gia hạn và trả sách *@

@* Họ và tên: Vũ Tiến Thành *@
@* Mã sinh viên: 23103100257 *@
@* Nội dung thực hiện: tách menu nhân viên (sidebar có icon SVG) và menu công khai theo tài liệu site.css *@

@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@inject ICurrentUserService Current

@* Menu chính theo vai trò. Chỉ để hiển thị: quyền [AuthorizeRole] kiểm tra ở Controller. *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string name, string? actionName = null) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) &&
        (actionName is null || string.Equals(action, actionName, StringComparison.OrdinalIgnoreCase))
        ? "is-active" : "";
    var isStaff = Current.IsAuthenticated && (Current.IsInRole(VaiTro.Admin) || Current.IsInRole(VaiTro.ThuThu));
}
@if (isStaff)
{
    <nav class="app-side-nav" aria-label="Menu quản lý">
        <div class="app-nav-heading">Tổng quan</div>
        <a class="app-nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12l9-8 9 8M5 10v10h14V10"/></svg></span>
            Trang chủ
        </a>
        <a class="app-nav-link @Active("Sach", "Catalog")" asp-controller="Sach" asp-action="Catalog">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg></span>
            Kho sách
        </a>

        @if (Current.IsInRole(VaiTro.Admin))
        {
            <div class="app-nav-heading">Quản trị</div>
            <a class="app-nav-link @Active("QuanLyTaiKhoan")" asp-controller="QuanLyTaiKhoan" asp-action="Index">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                Tài khoản
            </a>
            <a class="app-nav-link @Active("CauHinhThuVien")" asp-controller="CauHinhThuVien" asp-action="Index">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                Cấu hình
            </a>
        }

        <div class="app-nav-heading">Nghiệp vụ</div>
        @if (Current.IsInRole(VaiTro.Admin))
        {
            <a class="app-nav-link @Active("TheLoai")" asp-controller="TheLoai" asp-action="Index">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24H4a2 2 0 0 0-2 2v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l5.59-5.59a2 2 0 0 0 0-2.83z"/><circle cx="6.5" cy="8.5" r="1"/></svg></span>
                Thể loại
            </a>
        }
        <a class="app-nav-link @Active("Sach", "Index")" asp-controller="Sach" asp-action="Index">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg></span>
            Quản lý sách
        </a>
        <a class="app-nav-link @Active("PhieuMuon")" asp-controller="PhieuMuon" asp-action="Index">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 12h6M9 16h6M8 4h8a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 0 1 2-2z"/></svg></span>
            Phiếu mượn
        </a>
        <a class="app-nav-link @Active("GiaHanMuon")" asp-controller="GiaHanMuon" asp-action="Index">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
            Yêu cầu gia hạn
        </a>
        <a class="app-nav-link @Active("TraSach")" asp-controller="TraSach" asp-action="Index">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg></span>
            Trả sách
        </a>
    </nav>
}
else
{
    <div class="app-public-links">
        <a class="app-public-link @Active("Home")" asp-controller="Home" asp-action="Index">Trang chủ</a>
        <a class="app-public-link @Active("Sach")" asp-controller="Sach" asp-action="Catalog">Kho sách</a>
    </div>
}
