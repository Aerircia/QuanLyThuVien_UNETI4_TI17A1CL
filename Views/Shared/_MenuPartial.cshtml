@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@inject ICurrentUserService Current

@* Menu chính theo vai trò. Chỉ để hiển thị: quyền [AuthorizeRole] kiểm tra ở Controller.
   Mỗi module thêm liên kết của mình vào đây. *@
<ul class="navbar-nav me-auto">
    <li class="nav-item">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
    </li>

    @if (Current.IsInRole(VaiTro.Admin))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="QuanLyTaiKhoan" asp-action="Index">Quản lý tài khoản</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="CauHinhThuVien" asp-action="Index">Cấu hình thư viện</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="TheLoai" asp-action="Index">Thể loại</a>
        </li>

    }
    @if (Current.IsInRole(VaiTro.Admin, VaiTro.ThuThu))
    {
        <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Dashboard">Dashboard &amp; thống kê</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Sach" asp-action="Index">Sách</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="GiaHanMuon" asp-action="Index">Yêu cầu gia hạn</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="TraSach" asp-action="Index">Trả sách</a></li>
    }
</ul>