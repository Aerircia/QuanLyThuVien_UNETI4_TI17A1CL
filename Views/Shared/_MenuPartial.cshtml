@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: thiết kế menu phân quyền *@

@* Họ và tên: Vũ Ngọc Hương Giang *@
@* Mã sinh viên: 23103100280 *@
@* Nội dung thực hiện: thêm liên kết menu yêu cầu gia hạn và trả sách *@

@* Họ và tên: Phùng Ngọc Bảo *@
@* Mã sinh viên: 23103100278 *@
@* Nội dung thực hiện: thêm liên kết menu thóng kê và quản lý phiếu mượn, cập nhật layout*@

@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@using QuanLyThuVien_UNETI4_TI17A1CL.Services.Interfaces
@inject ICurrentUserService Current
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isStaff = Current.IsInRole(VaiTro.Admin, VaiTro.ThuThu);
}

@if (isStaff)
{
    <nav class="app-side-nav" aria-label="Các chức năng quản lý">
        <span class="app-nav-heading">Tổng quan</span>
        <a class="app-nav-link @(controller == "ThongKe" && action == "Dashboard" ? "is-active" : "")"
           asp-controller="ThongKe" asp-action="Dashboard" aria-current="@(controller == "ThongKe" && action == "Dashboard" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span>Dashboard</span>
        </a>
        <a class="app-nav-link @(controller == "ThongKe" && action != "Dashboard" ? "is-active" : "")"
           asp-controller="ThongKe" asp-action="Index" aria-current="@(controller == "ThongKe" && action != "Dashboard" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 16v-4M12 16V8M16 16v-6M20 16V3"/></svg></span><span>Thống kê báo cáo</span>
        </a>

        <span class="app-nav-heading">Nghiệp vụ thư viện</span>
        <a class="app-nav-link @(controller == "PhieuMuon" ? "is-active" : "")"
           asp-controller="PhieuMuon" asp-action="Index" aria-current="@(controller == "PhieuMuon" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v13H3V6a2 2 0 0 1 2-2Z"/><path d="M8 4V2h8v2M7 9h10M7 13h7"/></svg></span><span>Quản lý phiếu mượn</span>
        </a>
        <a class="app-nav-link @(controller == "Sach" ? "is-active" : "")"
           asp-controller="Sach" asp-action="Index" aria-current="@(controller == "Sach" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 4v16M12 4v16M16 4v16"/></svg></span><span>Quản lý sách</span>
        </a>
        <a class="app-nav-link @(controller == "BanDoc" ? "is-active" : "")"
           asp-controller="BanDoc" asp-action="Index" aria-current="@(controller == "BanDoc" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><span>Quản lý bạn đọc</span>
        </a>
        <a class="app-nav-link @(controller == "GiaHanMuon" ? "is-active" : "")"
           asp-controller="GiaHanMuon" asp-action="Index" aria-current="@(controller == "GiaHanMuon" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.5 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.5-3"/></svg></span><span>Yêu cầu gia hạn</span>
        </a>
        <a class="app-nav-link @(controller == "TraSach" ? "is-active" : "")"
           asp-controller="TraSach" asp-action="Index" aria-current="@(controller == "TraSach" ? "page" : null)">
            <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4v6h-6M20 10 13 3M4 14v6h6M4 20l7-7"/></svg></span><span>Trả sách</span>
        </a>

        @if (Current.IsInRole(VaiTro.Admin))
        {
            <span class="app-nav-heading">Hệ thống</span>
            <a class="app-nav-link @(controller == "TheLoai" ? "is-active" : "")"
               asp-controller="TheLoai" asp-action="Index" aria-current="@(controller == "TheLoai" ? "page" : null)">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 10-9 10L3 12 12 2Z"/><path d="m12 7 4.5 5-4.5 5-4.5-5L12 7Z"/></svg></span><span>Quản lý thể loại</span>
            </a>
            <a class="app-nav-link @(controller == "QuanLyTaiKhoan" ? "is-active" : "")"
               asp-controller="QuanLyTaiKhoan" asp-action="Index" aria-current="@(controller == "QuanLyTaiKhoan" ? "page" : null)">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="9" r="3"/><path d="M6.5 19a6 6 0 0 1 11 0"/></svg></span><span>Quản lý tài khoản</span>
            </a>
            <a class="app-nav-link @(controller == "CauHinhThuVien" ? "is-active" : "")"
               asp-controller="CauHinhThuVien" asp-action="Index" aria-current="@(controller == "CauHinhThuVien" ? "page" : null)">
                <span class="app-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.2 1-1.5 2.6-1.5-.6a8 8 0 0 1-1.7 1l-.2 1.6h-3l-.3-1.6a8 8 0 0 1-1.7-1l-1.5.6-1.5-2.6 1.3-1a7 7 0 0 1 0-2l-1.3-1 1.5-2.6 1.5.6a8 8 0 0 1 1.7-1l.3-1.6h3l.2 1.6a8 8 0 0 1 1.7 1l1.5-.6 1.5 2.6-1.2 1a7 7 0 0 1-.1 2Z" transform="translate(-1 -1) scale(1.08)"/></svg></span><span>Cấu hình thư viện</span>
            </a>
        }
    </nav>
}
else
{
    <ul class="navbar-nav app-public-nav">
        <li class="nav-item">
            <a class="nav-link @(controller == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index"
               aria-current="@(controller == "Home" ? "page" : null)">Kho sách</a>
        </li>
        @if (Current.IsInRole(VaiTro.BanDoc))
        {
            <li class="nav-item">
                <a class="nav-link @(controller == "PhieuMuon" && action == "MyLoans" ? "is-active" : "")"
                   asp-controller="PhieuMuon" asp-action="MyLoans" aria-current="@(controller == "PhieuMuon" && action == "MyLoans" ? "page" : null)">Phiếu mượn của tôi</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(controller == "PhieuMuon" && action == "MyFines" ? "is-active" : "")"
                   asp-controller="PhieuMuon" asp-action="MyFines" aria-current="@(controller == "PhieuMuon" && action == "MyFines" ? "page" : null)">Tiền phạt</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(controller == "BanDoc" ? "is-active" : "")"
                   asp-controller="BanDoc" asp-action="MyProfile" aria-current="@(controller == "BanDoc" ? "page" : null)">Thẻ &amp; hồ sơ</a>
            </li>
        }
    </ul>
}
