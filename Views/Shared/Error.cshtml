@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Trang lỗi dùng chung; mã 404 hiển thị thông báo không tìm thấy trang *@
@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? "Không tìm thấy trang" : "Có lỗi xảy ra";
}

<div class="text-center py-5">
    <div style="font-size:64px;font-weight:800;line-height:1;color:var(--app-ac)">@Model.StatusCode</div>
    <h1 class="h4 mt-3">@(notFound ? "Không tìm thấy trang" : "Có lỗi xảy ra")</h1>
    <p class="text-muted">
        @if (notFound)
        {
            <text>Đường dẫn bạn truy cập không tồn tại hoặc dữ liệu đã bị xóa. Hãy kiểm tra lại địa chỉ hoặc quay về trang chính.</text>
        }
        else
        {
            <text>Hệ thống không xử lý được yêu cầu của bạn. Vui lòng thử lại sau hoặc liên hệ thủ thư.</text>
        }
    </p>

    @if (!notFound && Model.ShowRequestId)
    {
        <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }

    <div class="d-flex justify-content-center gap-2 mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Về trang chủ</a>
        <a asp-controller="Home" asp-action="Catalog" class="btn btn-outline-secondary">Xem kho sách</a>
    </div>
</div>
