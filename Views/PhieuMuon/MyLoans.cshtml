@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View theo dõi danh sách phiếu mượn của bạn đọc (MyLoans) - hỗ trợ AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.MyLoansViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Phiếu mượn của tôi";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Phiếu mượn của tôi</h1>
            <p class="text-muted small mb-0">Theo dõi tiến trình xử lý, thời hạn trả sách và trạng thái các đầu sách đã đăng ký.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-search"></i> Tìm thêm sách
        </a>
    </div>

    <partial name="_AlertsPartial" />

    <div id="myLoansContainer">
        <partial name="_MyLoansListPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
    (() => {
        const container = document.getElementById('myLoansContainer');
        if (!container) return;

        let currentUrl = window.location.href;

        const showAlert = (message, type = 'success') => {
            const alertBox = document.getElementById('myLoansAlertContainer');
            if (!alertBox) return;
            alertBox.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        const loadContent = async (url, pushState = true) => {
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Network error');
                const html = await res.text();
                container.innerHTML = html;
                currentUrl = url;
                if (pushState) {
                    history.pushState(null, '', url);
                }
            } catch (err) {
                console.error('Failed to load my loans content', err);
                window.location.href = url;
            }
        };

        // Click chuyển tab phân loại bằng AJAX
        container.addEventListener('click', (e) => {
            const tabLink = e.target.closest('a.myloans-tab-link');
            if (tabLink && tabLink.href) {
                e.preventDefault();
                loadContent(tabLink.href);
            }
        });

        // Xử lý hủy phiếu bằng AJAX (được gọi sau khi người dùng xác nhận trên modal)
        document.addEventListener('submit', async (e) => {
            const form = e.target.closest('.myloans-cancel-form');
            if (!form) return;

            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const res = await fetch(form.action, {
                    method: form.method || 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json, text/html;q=0.9'
                    }
                });

                const data = await res.json();
                if (data.success) {
                    showAlert(data.message || 'Đã hủy phiếu mượn thành công.', 'success');
                } else {
                    showAlert(data.message || 'Không thể hủy phiếu mượn.', 'danger');
                }
                await loadContent(currentUrl, false);
            } catch (err) {
                console.error('Cancel loan error', err);
                window.location.reload();
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        });

        // Back / Forward browser navigation
        window.addEventListener('popstate', () => {
            loadContent(window.location.href, false);
        });
    })();
    </script>
}
