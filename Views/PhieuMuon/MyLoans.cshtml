@* Nội dung thực hiện: View theo dõi danh sách phiếu mượn của bạn đọc (MyLoans) - hỗ trợ AJAX *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.MyLoansViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Phiếu mượn của tôi";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0">Phiếu mượn của tôi</h1>
            <p class="text-muted small mb-0">Theo dõi tiến trình xử lý, thời hạn trả sách và trạng thái các đầu sách đã đăng ký.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-search"></i> Tìm thêm sách
        </a>
    </div>

    <partial name="_AlertsPartial" />

    <div id="myLoansContainer" data-ajax-list>
        <partial name="_MyLoansListPartial" model="Model" />
    </div>
</div>
