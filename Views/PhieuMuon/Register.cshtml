@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View đăng ký mượn sách (PhieuMuon/Register) *@

@* Họ và tên: Vũ Tiến Thành*@
@* Mã sinh viên: 23103100257*@
@* Nội dung thực hiện: Bổ sung View đăng ký mượn sách (PhieuMuon/Register) với các thông tin chi tiết về sách và bạn đọc, kiểm tra điều kiện mượn, và form xác nhận đăng ký mượn. *@

@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuMuonRegisterViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Đăng ký mượn sách - " + Model.TenSach;
}

<div class="container py-3">
    <div class="borrow-flow-steps" aria-label="Các bước đăng ký mượn">
        <span class="active">1 - Chọn sách ✓</span>
        <span class="active">2 - Xác nhận</span>
        <span>3 - Hoàn tất</span>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Đăng ký mượn sách</li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="h4 mb-0">Xác nhận đăng ký mượn sách</h1>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Quay lại danh mục</a>
            </div>

            @if (TempData["Loi"] is string loi)
            {
                <div class="alert alert-danger" role="alert">@loi</div>
            }

            <div class="row g-3">
                <!-- Cột thông tin sách -->
                <div class="col-md-5">
                    <div class="app-card h-100 borrow-register-book">
                        <div class="borrow-register-cover">
                            @if (!string.IsNullOrWhiteSpace(Model.ImgPath))
                            {
                                <img src="@Model.ImgPath" alt="Bìa sách @Model.TenSach" />
                            }
                            else
                            {
                                <div class="book-cover-mock text-center">
                                    <small class="text-uppercase tracking-wider">@(Model.TheLoai ?? "SÁCH THƯ VIỆN")</small>
                                    <div>
                                        <h5 class="text-white">@Model.TenSach</h5>
                                        <small class="text-white-50">@Model.TacGia</small>
                                    </div>
                                    <small>UNETI Library</small>
                                </div>
                            }
                        </div>

                        <h5 class="h6 fw-bold mb-2">@Model.TenSach</h5>
                        <p class="text-muted small mb-3">Tác giả: <strong>@Model.TacGia</strong></p>

                        <ul class="list-group list-group-flush small mb-3">
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Thể loại:</span>
                                <strong>@(Model.TheLoai ?? "—")</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Vị trí kệ:</span>
                                <span class="badge bg-secondary font-monospace">@(Model.ViTriKe ?? "Khu lưu trữ")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Năm xuất bản:</span>
                                <span>@Model.NamXuatBan</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Giá bìa:</span>
                                <span>@Model.GiaBia.ToString("N0") ₫</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Số bản sẵn sàng:</span>
                                <span class="badge @(Model.SoLuongConLai > 0 ? "bg-success" : "bg-danger")">
                                    Còn @Model.SoLuongConLai / @Model.SoLuongTong bản
                                </span>
                            </li>
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                        {
                            <div class="small text-muted border-top pt-2">
                                <strong>Mô tả:</strong> @Model.MoTa
                            </div>
                        }
                    </div>
                </div>

                <!-- Cột thông tin bạn đọc & form xác nhận -->
                <div class="col-md-7">
                    <div class="app-card mb-3">
                        <h6 class="fw-bold text-muted text-uppercase small mb-3">1. Thông tin bạn đọc mượn</h6>
                        <div class="p-3 bg-light rounded border mb-3">
                            <div class="row g-2 small">
                                <div class="col-sm-6">Bạn đọc: <strong class="text-dark">@Model.HoTenBanDoc</strong></div>
                                <div class="col-sm-6">Mã thẻ: <strong class="font-monospace text-dark">@(Model.MaSoThe ?? "Chưa cấp")</strong></div>
                                <div class="col-sm-6">Loại bạn đọc: <strong class="text-dark">@Model.LoaiBanDoc.GetDisplayName()</strong></div>
                                <div class="col-sm-6">Hạn thẻ: <strong class="text-dark">@Model.NgayHetHanThe.ToString("dd/MM/yyyy")</strong></div>
                                <div class="col-sm-6">Đang xử lý: <strong class="text-primary">@Model.SoPhieuDangXuLy / @Model.SoPhieuToiDa cuốn</strong></div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-muted text-uppercase small mb-3">2. Kiểm tra điều kiện mượn (EF Core / LINQ)</h6>
                        @if (!Model.DuDieuKienMuon)
                        {
                            <div class="alert alert-danger" role="alert">
                                <h6 class="alert-heading fw-bold mb-2">Không đủ điều kiện đăng ký mượn sách:</h6>
                                <ul class="mb-0 ps-3 small">
                                    @foreach (var err in Model.LyDoKhongDuDieuKien)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success d-flex align-items-center py-2" role="alert">
                                <span class="me-2">✓</span>
                                <div class="small">Tài khoản và đầu sách hoàn toàn <strong>đủ điều kiện mượn</strong> theo quy định thư viện.</div>
                            </div>
                        }

                        <h6 class="fw-bold text-muted text-uppercase small mb-2">3. Gửi yêu cầu đăng ký</h6>
                        <p class="text-muted small">
                            Ngày đăng ký do hệ thống tự động xác định là ngày hôm nay. Ngày mượn và hạn trả sẽ do thủ thư ghi nhận khi bạn đến nhận sách. Phiếu mới tạo sẽ ở trạng thái <strong>Chờ duyệt</strong>.
                        </p>

                        <form asp-action="Register" asp-route-id="@Model.MaSach" method="post" id="registerLoanForm">
                            <div class="mb-3">
                                <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Nhập ghi chú cho thủ thư nếu có..."></textarea>
                                <span asp-validation-for="GhiChu" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                                <button type="button" class="btn btn-primary px-4"
                                        data-confirm-form="#registerLoanForm"
                                        data-confirm-title="Xác nhận đăng ký mượn"
                                        data-confirm-message="Bạn có chắc chắn muốn gửi đăng ký mượn sách này?"
                                        data-confirm-ok="Xác nhận đăng ký"
                                        data-confirm-class="btn-primary"
                                        @(Model.DuDieuKienMuon ? "" : "disabled")>
                                    Xác nhận đăng ký mượn
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
