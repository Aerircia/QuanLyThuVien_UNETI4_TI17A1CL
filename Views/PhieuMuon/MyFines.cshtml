@* Họ và tên: Nguyễn Hữu Tuấn *@
@* Mã sinh viên: 23103100136 *@
@* Nội dung thực hiện: View theo dõi tiền phạt của bạn đọc (PhieuMuon/MyFines) *@

@* Họ và tên: Lại Anh Quân *@
@* Mã sinh viên: 23103100255 *@
@* Nội dung thực hiện: Component thanh toán tiền phạt *@
@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.MyFinesViewModel
@using QuanLyThuVien_UNETI4_TI17A1CL.Models.Enums
@{
    ViewData["Title"] = "Tiền phạt của tôi";
    var pending = ViewBag.PendingFineIds as HashSet<int> ?? new HashSet<int>();
    var payEnabled = ViewBag.PayEnabled is true;
}
@section Styles { <link rel="stylesheet" href="~/css/thanhtoan.css" asp-append-version="true" /> }

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h1 class="h4 mb-0">Tiền phạt của tôi</h1><p class="text-muted small mb-0">Chọn các khoản phạt muốn thanh toán trực tuyến qua payOS.</p></div>
        <a asp-controller="ThanhToan" asp-action="LichSu" class="btn btn-outline-secondary">Lịch sử thanh toán</a>
    </div>
    <partial name="_AlertsPartial" />

    <div class="row g-3 mb-3">
        <div class="col-sm-4"><div class="app-card"><small class="text-muted d-block">Tổng tiền phạt</small><strong class="fs-5">@Model.TongTienPhat.ToString("N0") ₫</strong></div></div>
        <div class="col-sm-4"><div class="app-card"><small class="text-muted d-block">Đã nộp</small><strong class="fs-5 text-success">@Model.DaNop.ToString("N0") ₫</strong></div></div>
        <div class="col-sm-4"><div class="app-card"><small class="text-muted d-block">Chưa nộp</small><strong class="fs-5 text-danger">@Model.ChuaNop.ToString("N0") ₫</strong></div></div>
    </div>

    @if (!payEnabled)
    {
        <div class="alert alert-info">Thanh toán trực tuyến hiện chưa khả dụng. Bạn có thể nộp phạt trực tiếp tại quầy thủ thư.</div>
    }

    <form asp-controller="ThanhToan" asp-action="Pay" method="post" id="payFinesForm" data-pay-form>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:44px"><input type="checkbox" class="form-check-input" data-fine-all aria-label="Chọn tất cả" @(payEnabled ? "" : "disabled") /></th>
                        <th>Phiếu mượn</th><th>Sách</th><th>Ngày trả</th><th>Tình trạng sách</th>
                        <th class="text-end">Số ngày trễ</th><th class="text-end">Tiền phạt</th><th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var f in Model.Fines)
                {
                    var payable = f.TrangThaiPhat == TrangThaiPhat.ChuaNop && f.TienPhat > 0;
                    <tr>
                        <td>
                            @if (payable && !pending.Contains(f.MaTra))
                            {
                                <input type="checkbox" class="form-check-input" name="maTras" value="@f.MaTra"
                                       data-fine-check data-amount="@((long)f.TienPhat)"
                                       aria-label="Chọn khoản phạt phiếu #@f.MaPhieuMuon" @(payEnabled ? "" : "disabled") />
                            }
                        </td>
                        <td>#@f.MaPhieuMuon</td>
                        <td>@f.TenSach</td>
                        <td>@f.NgayTra.ToString("dd/MM/yyyy")</td>
                        <td>@f.TinhTrangSach.GetDisplayName()</td>
                        <td class="text-end">@f.SoNgayTre ngày</td>
                        <td class="text-end fw-bold">@f.TienPhat.ToString("N0") ₫</td>
                        <td>
                            @if (pending.Contains(f.MaTra))
                            {
                                <span class="badge badge-soft-warning">Đang chờ thanh toán</span>
                            }
                            else
                            {
                                <span class="badge @(f.TrangThaiPhat == TrangThaiPhat.DaNop ? "badge-soft-success" : f.TrangThaiPhat == TrangThaiPhat.ChuaNop ? "badge-soft-danger" : "badge-soft-secondary")">@f.TrangThaiPhat.GetDisplayName()</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Fines.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Bạn chưa có khoản phạt nào.</td></tr>
                }
                </tbody>
            </table>
        </div>

        <div class="pay-bar">
            <div>Đã chọn <strong data-pay-count>0</strong> khoản</div>
            <div class="pay-total">Tổng thanh toán: <strong data-pay-total>0 ₫</strong></div>
            <button type="button" class="btn btn-primary" data-pay-submit disabled
                    data-confirm-form="#payFinesForm"
                    data-confirm-title="Thanh toán tiền phạt"
                    data-confirm-message="Bạn sẽ được chuyển sang cổng thanh toán payOS. Giao dịch hết hạn sau 10 phút nếu chưa hoàn tất."
                    data-confirm-ok="Tiếp tục thanh toán">Thanh toán</button>
        </div>
    </form>
</div>

@section Scripts { <script src="~/js/thanhtoan.js" asp-append-version="true"></script> }
