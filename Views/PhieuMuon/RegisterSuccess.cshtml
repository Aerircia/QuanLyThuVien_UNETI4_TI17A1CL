@* Họ và tên: Vũ Tiến Thành*@
@* Mã sinh viên: 23103100257*@
@* Nội dung thực hiện*: Bổ sung View hoàn tất đăng ký mượn sách (PhieuMuon/RegisterSuccess) với các thông tin chi tiết về phiếu mượn, sách và trạng thái đăng ký. *@

@model QuanLyThuVien_UNETI4_TI17A1CL.ViewModels.PhieuMuonRegisterSuccessViewModel
@{
    ViewData["Title"] = "Hoàn tất đăng ký mượn sách";
}

<div class="container py-3">
    <div class="borrow-flow-steps borrow-flow-steps--complete" aria-label="Các bước đăng ký mượn">
        <span>1 - Chọn sách ✓</span>
        <span>2 - Xác nhận ✓</span>
        <span>3 - Hoàn tất ✓</span>
    </div>

    <div class="app-card borrow-success">
        <div class="borrow-success-icon" aria-hidden="true">✓</div>
        <h1 class="h3">Đã gửi đăng ký mượn!</h1>
        <p class="text-muted">
            Thủ thư sẽ duyệt phiếu của bạn. Khi có thông báo được duyệt, hãy ghé quầy nhận sách.
        </p>

        <div class="borrow-success-summary">
            <div>
                <small class="text-muted d-block">Mã phiếu</small>
                <strong>#@Model.MaPhieuMuon</strong>
            </div>
            <div>
                <small class="text-muted d-block">Sách</small>
                <strong>@Model.TenSach</strong>
            </div>
            <div>
                <small class="text-muted d-block">Vị trí kệ</small>
                <strong>@(Model.ViTriKe ?? "—")</strong>
            </div>
            <div class="mt-3">
                <small class="text-muted d-block">Trạng thái</small>
                <strong>@Model.TrangThai</strong>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-action="MyLoans" class="btn btn-primary px-4">Xem phiếu của tôi</a>
            <a asp-controller="Home" asp-action="Catalog" class="btn btn-outline-secondary">Tiếp tục xem sách</a>
        </div>
    </div>
</div>
